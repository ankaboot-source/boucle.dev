            <p>{quickStart.data.transitionPrefix} <code>{quickStart.data.transitionTag}</code> {quickStart.data.transitionSuffix}</p>
          </div>

          <a class="quick-link" href={quickStart.data.docsHref}>
            {quickStart.data.docsLabel}
          </a>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer>
      <p class="footer-made">{footer.data.madePrefix} <a href={footer.data.madeHref}>{footer.data.madeLabel}</a></p>
      <nav class="footer-links" aria-label={footer.data.navAriaLabel}>
        {
          footer.data.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))
        }
      </nav>
      <p class="footer-icons">{footer.data.iconsPrefix} <a href={footer.data.iconsHref}>{footer.data.iconsLabel}</a></p>
    </footer>

    <script>
      // Card reveal animation — fades cards in when they enter the viewport.
      const cardObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              cardObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 }
      );
      document.querySelectorAll('.card').forEach((el) => cardObserver.observe(el));

      // Strike-through animation for pain points — triggers when card enters viewport.
      const painObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('strike');
              painObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 }
      );
      document.querySelectorAll('.pain-text').forEach((el) => painObserver.observe(el));

      // Quickstart toggle — switch between Oneliner and Prompt panels.
      document.querySelectorAll('.toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const tab = btn.dataset.tab;
          document.querySelectorAll('.toggle-btn').forEach((b) => {
            const isActive = b.dataset.tab === tab;
            b.classList.toggle('active', isActive);
            b.setAttribute('aria-selected', isActive);
          });
          document.querySelectorAll('.quick-panel').forEach((p) => {
            p.classList.toggle('active', p.dataset.panel === tab);
          });
        });
      });

      // Copy-to-clipboard for code panels.
      // Labels come from content via data attributes; if one is ever absent,
      // fall back to the label already rendered on the button (never a literal).
      document.querySelectorAll('.copy-btn').forEach((btn) => {
        const currentLabel = btn.textContent;
        const copyLabel = btn.dataset.label || currentLabel;
        const copiedLabel = btn.dataset.copied || currentLabel;
        const failedLabel = btn.dataset.failed || currentLabel;
        btn.addEventListener('click', async () => {
          const panel = btn.closest('.quick-panel');
          const code = panel.querySelector('code');
          try {
            await navigator.clipboard.writeText(code.textContent);
            btn.textContent = copiedLabel;
            btn.classList.add('copied');
            setTimeout(() => {
              btn.textContent = copyLabel;
              btn.classList.remove('copied');
            }, 2000);
          } catch {
            btn.textContent = failedLabel;
            setTimeout(() => {
              btn.textContent = copyLabel;
            }, 2000);
          }
        });
      });

      // Reduced motion — the animated hero logo is decorative motion. If the
      // user prefers reduced motion, remove autoplay so only the static PNG
      // poster is shown (pausing on the first frame).
      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      const heroVideos = document.querySelectorAll('.hero-logo-video video');
      const setAutoplay = (prefersReduced) => {
        heroVideos.forEach((video) => {
          if (prefersReduced) {
            video.removeAttribute('autoplay');
            video.pause();
          } else {
            video.setAttribute('autoplay', '');
            video.play().catch(() => {});
          }
        });
      };
      setAutoplay(motionQuery.matches);
      motionQuery.addEventListener('change', (e) => setAutoplay(e.matches));

      // ============ HOW-IT-WORKS SLIDESHOW ============
      // Shows one step at a time, loops 7 -> 1, auto-advances every 5s when
      // idle and in view, fully keyboard + reduced-motion accessible.
      (function () {
        const track = document.getElementById('steps-track');
        if (!track) return;
        const slides = Array.from(track.children).filter((el) =>
          el.classList.contains('step')
        );
        const total = slides.length;
        if (total < 2) return;

        const dotsWrap = document.getElementById('step-dots');
        const prevBtn = document.getElementById('step-prev');
        const nextBtn = document.getElementById('step-next');

        const reducedMotion =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let current = 0;
        let timer = null;

        // Build the dot indicator.
        const dots = [];
        slides.forEach((slide, i) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'step-dot';
          dot.setAttribute('aria-label', dotsWrap.dataset.dotLabelTemplate.replace('{n}', String(i + 1)).replace('{total}', String(total)));
          dot.addEventListener('click', () => goTo(i, true));
          dotsWrap.appendChild(dot);
          dots.push(dot);
        });

        function goTo(index, userInitiated) {
          if (index < 0) index = total - 1; // wrap backward
          if (index >= total) index = 0; // wrap forward (loop to first)
          current = index;
          track.classList.add('is-animating');
          track.style.transform = `translateX(-${current * 100}%)`;
          renderState();
          if (userInitiated) restartAutoplay();
        }

        function renderState() {
          slides.forEach((slide, i) => {
            slide.setAttribute('aria-hidden', i === current ? 'false' : 'true');
          });
          dots.forEach((dot, i) => {
            dot.classList.toggle('is-active', i === current);
            dot.setAttribute('aria-selected', i === current ? 'true' : 'false');
          });
        }

        function restartAutoplay() {
          stopAutoplay();
          if (reducedMotion) return; // never auto-play under reduced motion
          timer = window.setTimeout(() => {
            goTo(current + 1, false);
          }, 5000);
        }

        function stopAutoplay() {
          if (timer) {
            window.clearTimeout(timer);
            timer = null;
          }
        }

        // Enable keyboard navigation when focus is inside the section.
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
          const target = e.target;
          if (!target.closest('#how-it-works')) return;
          e.preventDefault();
          if (e.key === 'ArrowRight') goTo(current + 1, true);
          else goTo(current - 1, true);
        });

        prevBtn.addEventListener('click', () => goTo(current - 1, true));
        nextBtn.addEventListener('click', () => goTo(current + 1, true));

        // Pause autoplay when the section leaves the viewport.
        const section = track.closest('.how');
        if (section && 'IntersectionObserver' in window) {
          const sectionObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) restartAutoplay();
                else stopAutoplay();
              });
            },
            { threshold: 0.2 }
          );
          sectionObserver.observe(section);
        } else if (!reducedMotion) {
          restartAutoplay();
        }

        renderState();
      })();
    </script>
  </body>
</html>
