---
// boucle.dev — landing page
// Afro-futurist + Goldilocks. Single-page static site. The only raster asset
// is the brand logo: an animated GIF
// (public/boucle-logo.gif) in the hero. Everything else is CSS/inline SVG.
// Conforms to DESIGN.md (tokens, components, content directives).
// English copy (public, global audience). Self-hosted fonts (no CDN, GDPR).
// All user-facing text is extracted to src/content/ collections (issue #39);
// this file only imports and renders them. CSS, JS, SVG markup and structural
// HTML remain inline here.
import { getCollection } from 'astro:content';

const hero = (await getCollection('hero'))[0];
const howItWorks = (await getCollection('howItWorks'))[0];
const steps = (await getCollection('steps')).sort((a, b) => a.data.order - b.data.order);
const whyBoucle = (await getCollection('whyBoucle'))[0];
const cards = (await getCollection('cards')).sort((a, b) => a.data.order - b.data.order);
const quickStart = (await getCollection('quickStart'))[0];
const loopStatesHeader = (await getCollection('loopStatesHeader'))[0];
const loopStates = (await getCollection('loopStates')).sort((a, b) => a.data.order - b.data.order);
const footer = (await getCollection('footer'))[0];

const title = hero.data.metaTitle;
const description = hero.data.metaDescription;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    <link rel="icon" type="image/png" href="/boucle-logo.png" />
    <!-- Open Graph social-share preview (self-hosted assets only, GDPR-safe).
         og:image is the absolute URL of the static logo PNG at the apex domain
         https://boucle.dev/ so social crawlers resolve it correctly. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://boucle.dev/boucle-logo.png" />
    <meta property="og:url" content="https://boucle.dev/" />
    <style>
      /* Self-hosted fonts — no Google Fonts CDN (GDPR).
         Unbounded (display) and Sora (body) are variable fonts (wght axis),
         so a single woff2 serves the whole weight range. Space Mono is static. */
      @font-face {
        font-family: 'Unbounded';
        font-style: normal;
        font-weight: 200 900;
        font-display: swap;
        src: url('/fonts/unbounded.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Sora';
        font-style: normal;
        font-weight: 400 800;
        font-display: swap;
        src: url('/fonts/sora.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Space Mono';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/space-mono-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Space Mono';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/space-mono-700.woff2') format('woff2');
      }

      :root {
        /* Forge surfaces — GitHub-dark-inspired (Primer Product UI), per DESIGN §2. */
        --surface-base: #0d1117;
        --bg-secondary: #161b22;
        --surface-raised: #21262d;
        /* Afro-futurist accents — preserved, unchanged. */
        --accent: #f5c842;
        --accent-gold-dim: #c9a233;
        --accent-violet: #7b2ff7;
        --accent-cyan: #00e5ff;
        --text-primary: #f0f0f5;
        --text-secondary: #a0a0b8;
        --text-gold: #f5c842;
        --border: rgba(245, 200, 66, 0.15);
        --border-neutral: rgba(255, 255, 255, 0.08);
        --glow-gold: rgba(245, 200, 66, 0.3);
        --glow-violet: rgba(123, 47, 247, 0.25);
        /* Forge radii & shadows (Primer/Pajamas) */
        --radius: 6px;
        --shadow-subtle: 0 1px 3px rgba(0, 0, 0, 0.3);
        --font-display: 'Unbounded', 'Sora', sans-serif;
        --font-body: system-ui, 'Sora', sans-serif;
        --font-mono: 'Space Mono', monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--surface-base);
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* Skip link for keyboard users */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: var(--accent);
        color: var(--surface-base);
        font-weight: 600;
        text-decoration: none;
        border-radius: var(--radius);
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
      }

      a {
        color: var(--accent-cyan);
      }
      a:hover {
        color: var(--accent);
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      section {
        padding: clamp(3rem, 8vw, 6rem) 1.5rem;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        margin: 0 0 1rem;
        line-height: 1.15;
      }

      h2 {
        font-size: clamp(1.8rem, 4vw, 3rem);
        font-weight: 600;
        text-align: center;
      }

      .section-sub {
        text-align: center;
        color: var(--text-secondary);
        max-width: 640px;
        margin: 0 auto 3rem;
      }

      /* ============ HERO ============ */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        background: linear-gradient(180deg, var(--surface-base), var(--bg-secondary));
        padding: 4rem 1.5rem;
      }

      .hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        animation: glow-pulse 4s ease-in-out infinite;
      }
      .hero-glow--violet {
        width: 480px;
        height: 480px;
        background: var(--glow-violet);
        top: -120px;
        left: -120px;
      }
      .hero-glow--gold {
        width: 420px;
        height: 420px;
        background: var(--glow-gold);
        bottom: -140px;
        right: -120px;
        animation-delay: 2s;
      }

      @keyframes glow-pulse {
        0%,
        100% {
          opacity: 0.5;
          transform: scale(1);
        }
        50% {
          opacity: 1;
          transform: scale(1.08);
        }
      }

      /* Subtle kente/adinkra-inspired geometric band (Sahelian motif).
         Decorative only, low opacity, aria-hidden, no motion. */
      .hero-motif {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: min(720px, 90vw);
        height: 14px;
        opacity: 0.35;
        pointer-events: none;
        background-image: repeating-linear-gradient(
          90deg,
          var(--accent) 0 6px,
          transparent 6px 12px,
          var(--accent-violet) 12px 16px,
          transparent 16px 22px,
          var(--accent-cyan) 22px 26px,
          transparent 26px 32px
        );
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
      }

      .hero-inner {
        position: relative;
        z-index: 1;
        max-width: 1100px;
        width: 100%;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        align-items: center;
      }

      .hero-copy {
        max-width: 640px;
        margin: 0 auto;
      }

      .logo-lockup {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 2rem;
      }
      .wordmark {
        font-family: var(--font-display);
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-gold);
        letter-spacing: 0.02em;
      }

      .hero-logo-video {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .hero-logo-video img {
        width: min(340px, 70vw);
        height: auto;
        border-radius: var(--radius);
        display: block;
      }

      .hero h1 {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 700;
        margin-bottom: 1.25rem;
      }

      .hero-sub {
        font-size: clamp(1.05rem, 2.2vw, 1.35rem);
        color: var(--text-secondary);
        max-width: 620px;
        margin: 0 auto 2.5rem;
      }

      /* Forge badges — "Lives in your forge" visual cue (Primer/Pajamas look:
         6px radius, subtle neutral border, raised bg, small mono-ish font). */
      .forge-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        list-style: none;
        margin: 0 auto 2.5rem;
        padding: 0;
      }
      .forge-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.85rem;
        background: var(--surface-raised);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        box-shadow: var(--shadow-subtle);
        color: var(--text-secondary);
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-decoration: none;
        transition: color 0.2s ease, border-color 0.2s ease;
      }
      .forge-badge:hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .forge-badge svg {
        width: 16px;
        height: 16px;
        display: block;
      }

      .hero-ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
      }

      .btn {
        display: inline-block;
        padding: 0.85rem 1.75rem;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.05rem;
        text-decoration: none;
        border-radius: var(--radius);
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      }
      .btn--primary {
        background: var(--accent);
        color: var(--surface-base);
      }
      .btn--primary:hover {
        background: var(--accent-gold-dim);
        color: var(--surface-base);
      }
      .btn--ghost {
        border: 1px solid var(--border);
        color: var(--text-primary);
      }
      .btn--ghost:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      /* ============ HOW IT WORKS ============ */
      .how {
        background: var(--surface-base);
      }

      .steps {
        position: relative;
        margin-top: 2rem;
      }

      /* Slideshow viewport — a flex track shows exactly one step at a time.
         `overflow: hidden` lives on the `.steps-viewport` WRAPPER, never on
         the `.steps-track` that receives the `translateX` transform: if the
         transformed element also clipped, the clip window would move with the
         track and always show the same first slide. With no JS transform the
         first step is shown (no flash of all steps, no blank container). The
         track height matches the tallest slide, so the container does not
         jump between steps. */
      .steps-viewport {
        overflow: hidden;
      }
      .steps-track {
        display: flex;
        align-items: stretch;
      }
      .steps-track.is-animating {
        transition: transform 0.5s ease;
      }

      .step {
        position: relative;
        flex: 0 0 100%;
        max-width: 100%;
        min-width: 0;
        padding-left: 0;
      }

      /* Slideshow controls — prev/next arrows (44x44px touch targets) and a
         dot indicator. Dots are forge-radius squares, not circles (radius 50%
         is reserved for the hero glow blobs). */
      .steps-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        margin-top: 1.5rem;
      }

      .step-nav {
        flex: 0 0 auto;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-secondary);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        color: var(--text-primary);
        cursor: pointer;
        transition: border-color 0.2s ease, color 0.2s ease;
      }
      .step-nav:hover {
        border-color: var(--accent);
        color: var(--accent);
      }
      .step-nav:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .step-nav .nav-arrow {
        width: 22px;
        height: 22px;
        background-color: currentColor;
        -webkit-mask-image: var(--nav-arrow-mask);
        mask-image: var(--nav-arrow-mask);
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-position: center;
        mask-position: center;
        -webkit-mask-size: contain;
        mask-size: contain;
      }

      .step-dots {
        display: flex;
        gap: 0.5rem;
      }
      /* The step dots are created dynamically by the slideshow JS
         (document.createElement), so they never carry Astro's scoped
         data-astro-cid attribute. These rules MUST be global (:global) or
         the scoped selectors never match and the active gold line does not
         render (issue #69). */
      :global(.step-dot) {
        width: 14px;
        height: 6px;
        padding: 0;
        border: none;
        border-radius: var(--radius);
        background: var(--border-neutral);
        cursor: pointer;
        transition: background 0.2s ease, width 0.2s ease;
      }
      :global(.step-dot:hover) {
        background: var(--accent-gold-dim);
      }
      :global(.step-dot.is-active) {
        width: 44px;
        background: var(--accent);
      }
      :global(.step-dot:focus-visible) {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      /* Visible step-number indicator — "2 / 7". Uses a tabular figure so
         the counter does not shift when the digits change. aria-live lets
         screen readers announce step changes. */
      .step-counter {
        min-width: 3.5rem;
        text-align: center;
        font-variant-numeric: tabular-nums;
        font-size: 0.875rem;
        color: var(--text-secondary);
        white-space: nowrap;
      }

      .step-head {
        display: flex;
        gap: 1.25rem;
        align-items: flex-start;
      }

      .step-icon {
        flex: 0 0 auto;
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-secondary);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        color: var(--accent);
      }
      .step-icon img {
        width: 28px;
        height: 28px;
      }

      .step-body h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 0.35rem;
      }
      .step-body p {
        margin: 0;
        color: var(--text-secondary);
      }

      /* Forge mini-mockup — pure HTML/CSS, no external images.
         Text tokens (primary/secondary) on bg-secondary/raised keep
         WCAG 2.1 AA contrast (>= 4.5:1). Decorative internals are
         aria-hidden; the mock carries a role="img" aria-label. */
      .forge-mock {
        margin-top: 1.25rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 0;
        overflow: hidden;
        text-align: left;
        font-size: 0.8rem;
        line-height: 1.4;
      }
      .mock-bar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.75rem;
        background: var(--surface-raised);
        border-bottom: 1px solid var(--border);
      }
      .mock-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--border);
      }
      .mock-url {
        color: var(--text-secondary);
        font-size: 0.7rem;
        margin-left: 0.25rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .mock-body {
        padding: 0.85rem 0.9rem;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        color: var(--text-secondary);
      }
      .mock-title {
        margin: 0;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-desc,
      .mock-meta,
      .mock-comment,
      .mock-hint,
      .mock-pr-title {
        margin: 0;
      }
      .mock-meta {
        font-size: 0.72rem;
      }
      .mock-badge {
        display: inline-block;
        width: fit-content;
        padding: 0.15rem 0.55rem;
        margin: 0;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border-radius: 999px;
      }
      .mock-badge--issue {
        color: var(--surface-base);
        background: var(--accent);
      }
      .mock-badge--live {
        color: var(--text-primary);
        background: rgba(0, 229, 255, 0.18);
        border: 1px solid rgba(0, 229, 255, 0.4);
      }
      .mock-avatar {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 999px;
        background: var(--text-secondary);
        vertical-align: middle;
        margin-right: 0.35rem;
      }
      .mock-avatar--gold {
        background: var(--accent);
      }
      .mock-author {
        margin: 0;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-preview {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0.6rem;
        background: var(--surface-base);
        border: 1px solid var(--border);
      }
      .mock-preview-line {
        display: block;
        height: 7px;
        background: var(--border);
      }
      .mock-preview-line--short {
        width: 60%;
      }
      .mock-preview-block {
        display: block;
        height: 42px;
        background: var(--surface-raised);
        border: 1px solid var(--border);
      }
      .mock-preview-dual {
        display: flex;
        gap: 0.5rem;
        align-items: stretch;
      }
      .mock-preview-frame {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0.5rem;
        background: var(--surface-base);
        border: 1px solid var(--border);
        min-width: 0;
      }
      .mock-preview-frame--mobile {
        flex: 0 0 38%;
      }
      .mock-preview-frame--desktop {
        flex: 1 1 auto;
      }
      .mock-preview-frame-label {
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--text-secondary);
      }
      .mock-e2e {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin: 0;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-e2e-check {
        width: 11px;
        height: 11px;
        flex: none;
        color: var(--accent);
      }
      .mock-reactions {
        display: flex;
        gap: 0.5rem;
      }
      .mock-reaction {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.55rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 0.75rem;
        color: var(--text-secondary);
      }
      .mock-reaction--active {
        border-color: var(--accent);
        color: var(--accent);
      }
      .mock-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-spinner {
        width: 12px;
        height: 12px;
        border: 2px solid var(--border);
        border-top-color: var(--accent);
        border-radius: 999px;
        animation: mock-spin 0.9s linear infinite;
      }
      @keyframes mock-spin {
        to {
          transform: rotate(360deg);
        }
      }
      .mock-pulse {
        width: 9px;
        height: 9px;
        border-radius: 999px;
        background: var(--accent);
        animation: mock-pulse 1.4s ease-in-out infinite;
      }
      @keyframes mock-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.3;
        }
      }
      .mock-verdict {
        display: inline-block;
        width: fit-content;
        padding: 0.2rem 0.7rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        border-radius: 999px;
      }
      .mock-verdict--pass {
        color: var(--surface-base);
        background: var(--accent);
      }
      .mock-verdict--merged {
        color: var(--surface-base);
        background: var(--accent);
      }

      /* ============ VALIDATION FLOW ANIMATIONS ============ */
      /* Subtle gestures that bring the validation cycle to life.
         CSS-only, sequenced: thumb-up → verdict → deploy.
         The ambient loop pulse runs continuously in the hero. */
      .flow-thumb {
        animation: flow-fade-in-up 0.6s ease-out 0.3s both;
      }
      .flow-verdict {
        animation: flow-fade-in 0.6s ease-out 1s both;
      }
      .mock-deploy {
        display: block;
        height: 6px;
        margin: 0.6rem 0;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface-raised);
      }
      .mock-deploy-fill {
        display: block;
        height: 100%;
        transform-origin: left;
        transform: scaleX(0);
        background: var(--accent);
        border-radius: 999px;
        animation: deploy-fill 0.6s ease-out 1.7s both;
      }
      .mock-deploy-label {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.5rem;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-deploy-check {
        width: 11px;
        height: 11px;
        flex: none;
        color: var(--accent);
        animation: flow-fade-in 0.5s ease-out 2.1s both;
      }
      .loop-pulse {
        animation: loop-pulse 3s ease-in-out infinite;
      }
      @keyframes flow-fade-in-up {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes flow-fade-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      @keyframes deploy-fill {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }
      @keyframes loop-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.45;
        }
      }

      /* ============ LIVES IN YOUR FORGE ============ */
      .forge {
        background: var(--surface-base);
      }
      .forge-message {
        text-align: center;
        color: var(--text-primary);
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
        font-weight: 600;
        max-width: 640px;
        margin: 0 auto 3rem;
      }
      .forge-logos {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .forge-logos a {
        display: inline-flex;
        align-items: center;
        color: var(--text-primary);
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .forge-logos a:hover {
        color: var(--accent);
      }
      .forge-logos svg {
        width: clamp(120px, 20vw, 180px);
        height: auto;
        display: block;
      }

      /* ============ WHY BOUCLE ============ */
      .why {
        background: var(--bg-secondary);
      }

      .cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .card {
        background: var(--surface-base);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        box-shadow: var(--shadow-subtle);
        padding: 1.75rem;
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s ease, transform 0.6s ease, border-color 0.3s ease, box-shadow 0.3s ease;
      }
      .card.is-visible {
        opacity: 1;
        transform: translateY(0);
      }
      .card:hover {
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent), 0 0 24px var(--glow-gold);
      }
      .card-head {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
      }
      .card-icon {
        flex-shrink: 0;
        width: 2.5rem;
        height: 2.5rem;
        display: block;
      }
      .card h3 {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--accent);
        margin: 0;
      }
      .card .pain {
        color: var(--text-secondary);
        margin: 0 0 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .card .remove {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1rem;
        height: 1rem;
        color: var(--accent-violet);
      }
      .card .remove img {
        width: 1rem;
        height: 1rem;
      }
      .card .answer {
        color: var(--text-primary);
        margin: 0;
      }

      /* Featured promise — "Lives in your forge", the key differentiator.
         Spans the full card grid width and gets a distinct gold treatment. */
      .card--featured {
        grid-column: 1 / -1;
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent), 0 0 24px var(--glow-gold);
        padding: 2.25rem;
      }
      .card--featured h3 {
        font-size: 1.5rem;
      }

      .why-positioning {
        margin: 2.5rem auto 0;
        max-width: 640px;
        text-align: center;
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
        font-weight: 600;
        color: var(--text-gold);
      }

      /* ============ LOOP STATES ============ */
      /* The label state machine rendered as a progression. Autonomous states
         read cyan, human-decision states gold, terminal states muted exits.
         Only existing DESIGN.md §2 tokens are used — no new colours. No
         animation or scroll-triggered reveal (non-goal). */
      .loop {
        background: var(--surface-base);
      }
      .loop-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        margin: 0 0 2.5rem;
        padding: 0;
        list-style: none;
        color: var(--text-secondary);
        font-size: 0.85rem;
      }
      .loop-legend li {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      .loop-legend .legend-swatch {
        width: 14px;
        height: 14px;
        flex: none;
        border-radius: var(--radius);
      }
      .legend-swatch--autonomous {
        background: var(--accent-cyan);
      }
      .legend-swatch--human {
        background: var(--accent);
      }
      .legend-swatch--terminal {
        background: var(--text-secondary);
      }

      /* Main sequence — a wrapping numbered flow so reading order stays
         left-to-right, top-to-bottom. On wide screens the states form rows;
         on narrow screens a connector runs down the left edge through the
         number badges (see the <768px rail). */
      .loop-flow {
        position: relative;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.1rem;
        margin: 0 auto;
        max-width: 720px;
      }
      /* Mobile connector rail — runs down the left edge through the number
         badges, showing the sequence is connected top-to-bottom. Centred on
         the badge column (1.1rem padding + half the 2.25rem badge). */
      .loop-flow::before {
        content: '';
        position: absolute;
        left: 2.2rem;
        top: 0.6rem;
        bottom: 0.6rem;
        width: 1px;
        background: var(--border-neutral);
      }
      .loop-node {
        position: relative;
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        background: var(--surface-raised);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        padding: 1rem 1.1rem;
        min-width: 0;
      }
      .loop-node__num {
        flex: none;
        width: 2.25rem;
        height: 2.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius);
        background: var(--bg-secondary);
        border: 1px solid var(--border-neutral);
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 700;
        position: relative;
        z-index: 1;
      }
      .loop-node__body {
        min-width: 0;
      }
      .loop-node__chip {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        padding: 0.2rem 0.7rem;
        border-radius: var(--radius);
        margin-bottom: 0.4rem;
      }
      .loop-node__type {
        display: inline-block;
        margin-left: 0.5rem;
        font-family: var(--font-body);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--text-secondary);
      }
      .loop-node__desc {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.9rem;
        line-height: 1.5;
      }

      /* Autonomous — cyan chip on raised surface (DESIGN §2 cyan token). */
      .loop-node--autonomous .loop-node__chip {
        color: var(--surface-base);
        background: var(--accent-cyan);
      }
      .loop-node--autonomous .loop-node__num {
        color: var(--accent-cyan);
        border-color: var(--accent-cyan);
      }
      /* Human decides — gold chip (DESIGN §2 gold token). */
      .loop-node--human .loop-node__chip {
        color: var(--surface-base);
        background: var(--accent);
      }
      .loop-node--human .loop-node__num {
        color: var(--accent);
        border-color: var(--accent);
      }
      /* Terminal exits — muted, struck-through label so they read as exits
         from the loop, not steps in it. */
      .loop-node--terminal {
        opacity: 0.82;
        border-style: dashed;
        border-color: var(--border-neutral);
      }
      .loop-node--terminal .loop-node__chip {
        color: var(--text-secondary);
        background: var(--bg-secondary);
        text-decoration: line-through;
        text-decoration-color: var(--text-secondary);
      }
      .loop-node--terminal .loop-node__num {
        color: var(--text-secondary);
      }

      /* Escalation branch — the human escalation state (boucle:human) is a
         terminal exit that branches off the main path rather than sitting in
         sequence. It is pulled out of the numbered ordered list into its own
         branch block with a visible join notch connecting it back to the main
         flow. It keeps the terminal treatment (muted, struck-through label)
         so it reads as an exit. */
      .loop-branch {
        position: relative;
        margin: 1.1rem 0 0;
        padding-left: 2.4rem;
        color: var(--text-secondary);
        font-size: 0.8rem;
      }
      .loop-branch__join {
        position: absolute;
        left: 1.15rem;
        top: 0;
        width: 1.1rem;
        height: 1px;
        background: var(--border-neutral);
      }
      .loop-branch__join::before {
        content: '';
        position: absolute;
        left: 0;
        top: -1.1rem;
        width: 1px;
        height: 1.6rem;
        background: var(--border-neutral);
      }
      .loop-branch__tag {
        margin: 0 0 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--text-secondary);
      }
      .loop-branch .loop-node--escalation .loop-node__num {
        color: var(--text-secondary);
      }

      @media (min-width: 768px) {
        .loop-flow::before {
          display: none;
        }
        .loop-flow {
          grid-template-columns: repeat(2, 1fr);
          max-width: 820px;
        }
        .loop-branch__join {
          display: none;
        }
        .loop-branch {
          max-width: 820px;
          text-align: center;
        }
      }
      @media (min-width: 1024px) {
        .loop-flow {
          grid-template-columns: repeat(4, 1fr);
          max-width: 1040px;
        }
        .loop-branch {
          max-width: 1040px;
        }
      }

      /* ============ QUICK START ============ */
      .quick {
        background: var(--surface-base);
      }

      .quick-install {
        max-width: 720px;
        margin: 0 auto;
      }
      .quick-install .label {
        font-family: var(--font-mono);
        color: var(--accent);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }
      .code {
        background: var(--surface-raised);
        border-radius: var(--radius);
        padding: 0.9rem 1rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--accent-cyan);
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-word;
        margin: 0;
      }

      /* The install→usage transition: a visually distinct panel that marks
         the shift from "setup tooling" to "daily usage in your own forge".
         Gold border + raised background per charter §2 tokens. */
      .quick-transition {
        max-width: 720px;
        margin: 1.5rem auto 0;
        background: var(--bg-secondary);
        border: 1px solid var(--accent);
        border-radius: var(--radius);
        padding: 1.5rem;
        box-shadow: 0 0 24px var(--glow-gold);
      }
      .quick-transition .num {
        font-family: var(--font-mono);
        color: var(--accent);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }
      .quick-transition p {
        margin: 0;
        color: var(--text-primary);
      }
      .quick-transition code {
        font-family: var(--font-mono);
        color: var(--accent);
        background: var(--surface-raised);
        padding: 0.1rem 0.35rem;
        border-radius: var(--radius);
      }

      .quick-link {
        display: block;
        margin: 2rem auto 0;
        width: fit-content;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
      }
      .quick-link:hover {
        color: var(--accent-gold-dim);
      }

      /* ============ FOOTER ============ */
      footer {
        background: var(--surface-base);
        border-top: 1px solid var(--border);
        padding: 2.5rem 1.5rem;
        text-align: center;
      }
      .footer-logo {
        display: block;
        width: 2.5rem;
        height: auto;
        margin: 0 auto 1rem;
      }
      .footer-made {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin: 0 0 1rem;
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        justify-content: center;
        font-size: 0.9rem;
      }
      .footer-links a {
        color: var(--text-secondary);
        text-decoration: none;
      }
      .footer-links a:hover {
        color: var(--accent);
      }
      .footer-icons {
        color: var(--text-secondary);
        font-size: 0.75rem;
        margin: 1rem 0 0;
      }
      .footer-icons a {
        color: var(--text-secondary);
        text-decoration: none;
      }
      .footer-icons a:hover {
        color: var(--accent);
      }

      /* ============ RESPONSIVE ============ */
      @media (min-width: 768px) {
        .cards {
          grid-template-columns: repeat(2, 1fr);
        }
        .forge-logos {
          flex-direction: row;
          justify-content: center;
          gap: 3rem;
        }
      }
      @media (min-width: 1024px) {
        .hero-inner {
          grid-template-columns: 1.2fr 1fr;
          text-align: left;
        }
        .hero-copy {
          margin: 0;
        }
        .hero-copy .hero-sub,
        .hero-ctas {
          justify-content: flex-start;
        }
        .hero-copy .hero-sub {
          margin-left: 0;
          margin-right: 0;
          text-align: left;
        }
        /* Slideshow shows one step at a time at every breakpoint; the step
           content becomes centered on wider screens. */
        .step-head {
          flex-direction: column;
          align-items: center;
          text-align: center;
        }
        .step-body p {
          max-width: 260px;
          margin: 0 auto;
        }
        .cards {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      /* ============ STRIKE-THROUGH ANIMATION (Why boucle pain points) ============
         A repeating-linear-gradient background draws a 2px violet line at the
         vertical center of each 1.6em line-height tile, so every wrapped line
         of text gets its own strike line (works on any number of lines). The
         reveal is animated by transitioning the background width from 0 to
         100%, preserving the left-to-right 1.4s ease-in-out scroll-reveal. */
      .pain-text {
        background-image: linear-gradient(
          to bottom,
          transparent 0,
          transparent calc(50% - 1px),
          var(--accent-violet) calc(50% - 1px),
          var(--accent-violet) calc(50% + 1px),
          transparent calc(50% + 1px)
        );
        background-size: 0 1.6em;
        background-repeat: repeat-y;
        transition: background-size 1.4s ease-in-out;
      }
      .pain-text.strike {
        background-size: 100% 1.6em;
      }

      /* ============ WHY BOUCLE SUBTITLE (gold positioning text) ============ */
      .why .section-sub {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--text-gold);
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
      }

      /* ============ HOW IT WORKS — OFFICIAL FORGE LOGOS ============ */
      .how-logos {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 2.5rem;
        list-style: none;
        margin: 0 auto 3rem;
        padding: 0;
      }
      .how-logos li {
        display: inline-flex;
        align-items: center;
      }
      .how-logos img {
        height: clamp(56px, 10vw, 80px);
        width: auto;
        display: block;
      }

      /* ============ QUICKSTART TOGGLE ============ */
      .quick-toggle {
        display: flex;
        max-width: 720px;
        margin: 0 auto;
      }
      .toggle-btn {
        padding: 0.5rem 1.5rem;
        background: var(--surface-raised);
        border: 1px solid var(--border-neutral);
        border-bottom: none;
        border-radius: var(--radius) var(--radius) 0 0;
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition:
          background-color 0.2s ease,
          color 0.2s ease,
          border-color 0.2s ease;
      }
      .toggle-btn.active {
        background: var(--accent);
        color: var(--surface-base);
        border-color: var(--accent);
      }
      .toggle-btn:not(.active):hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .quick-panels {
        max-width: 720px;
        margin: 0 auto;
      }
      .quick-panel {
        display: none;
      }
      .quick-panel.active {
        display: block;
      }
      .quick-panel .code {
        border-radius: 0 var(--radius) var(--radius) var(--radius);
        margin: 0;
      }
      .copy-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.75rem;
        padding: 0.4rem 1rem;
        background: transparent;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        cursor: pointer;
        transition:
          color 0.2s ease,
          border-color 0.2s ease;
      }
      .copy-btn:hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .copy-btn.copied {
        color: var(--accent);
        border-color: var(--accent);
      }

      /* ============ REDUCED MOTION ============ */
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .hero-glow {
          animation: none;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">{hero.data.skipLink}</a>

    <main id="main">
      <!-- ============ HERO ============ -->
      <section class="hero" aria-label={hero.data.sectionAriaLabel}>
        <div class="hero-glow hero-glow--violet" aria-hidden="true"></div>
        <div class="hero-glow hero-glow--gold" aria-hidden="true"></div>
        <div class="hero-motif" aria-hidden="true"></div>

        <div class="hero-inner">
          <div class="hero-copy">
            <div class="logo-lockup" aria-label={hero.data.logoAriaLabel}>
              <span class="wordmark">{hero.data.wordmark}</span>
            </div>

            <h1>{hero.data.headline}</h1>
            <p class="hero-sub">
              {hero.data.subheadline}
            </p>

            <div class="hero-ctas">
              <a class="btn btn--primary" href={hero.data.ctaPrimaryHref}>{hero.data.ctaPrimaryLabel}</a>
              <a class="btn btn--ghost" href={hero.data.ctaSecondaryHref}>{hero.data.ctaSecondaryLabel}</a>
            </div>
          </div>

          <div class="hero-logo-video">
            <!-- Animated brand logo, shown large on its own standalone column
                 (desktop). Decorative brand identity: aria-hidden and empty alt
                 so assistive tech skips it. Animated GIFs play natively and
                 cannot be paused by prefers-reduced-motion. -->
            <img
              src="/boucle-logo.gif"
              width="540"
              height="540"
              alt=""
              aria-hidden="true"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- ============ HOW IT WORKS ============ -->
      <section class="how" id="how-it-works" aria-labelledby="how-title">
        <div class="container">
          <h2 id="how-title">{howItWorks.data.title}</h2>
          <p class="section-sub">
            {howItWorks.data.sub}
          </p>

          <ul class="how-logos" aria-label={howItWorks.data.logosAriaLabel}>
            <li>
              <img
                src={howItWorks.data.githubSrc}
                alt={howItWorks.data.githubAlt}
                class="github-logo"
                loading="lazy"
                decoding="async"
              />
            </li>
            <li>
              <img
                src={howItWorks.data.gitlabSrc}
                alt={howItWorks.data.gitlabAlt}
                loading="lazy"
                decoding="async"
              />
            </li>
          </ul>

          <div class="steps">
            <div class="steps-viewport">
              <div class="steps-track" id="steps-track">
            {
              steps.map((step, i) => (
                <div class="step" role="group" aria-roledescription="slide" aria-label={howItWorks.data.slideAriaLabelTemplate.replace('{n}', String(i + 1)).replace('{total}', String(steps.length))} aria-hidden={i === 0 ? 'false' : 'true'}>
                  <div class="step-head">
                    <div class="step-icon" aria-hidden="true">
                      {step.data.icon && <img src={step.data.icon} alt="" aria-hidden="true" />}
                    </div>
                    <div class="step-body">
                      <h3>{step.data.title}</h3>
                      <p>{step.data.description}</p>
                    </div>
                  </div>
                  <div class="forge-mock" role="img" aria-label={step.data.ariaLabel}>
                    <div class="mock-bar" aria-hidden="true">
                      <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                      {step.data.url && <span class="mock-url">{step.data.url}</span>}
                    </div>
                    {step.data.blocks.length > 0 && (
                    <div class="mock-body" aria-hidden="true">
                      {
                        step.data.blocks.map((block) => {
                          switch (block.type) {
                            case 'badge':
                              return <p class={`mock-badge ${block.className ?? ''}`}>{block.text}</p>;
                            case 'title':
                              return <p class="mock-title">{block.text}</p>;
                            case 'desc':
                              return <p class="mock-desc">{block.text}</p>;
                            case 'meta':
                              return (
                                <p class="mock-meta">
                                  {block.avatarClass !== undefined && <span class={'mock-avatar' + (block.avatarClass ? ` ${block.avatarClass}` : '')}></span>}
                                  {block.text}
                                </p>
                              );
                            case 'author':
                              return (
                                <p class="mock-author">
                                  <span class={'mock-avatar' + (block.avatarClass ? ` ${block.avatarClass}` : '')}></span>
                                  {block.text}
                                </p>
                              );
                            case 'comment':
                              return <p class="mock-comment">{block.text}</p>;
                            case 'preview':
                              return (
                                <div class="mock-preview">
                                  <span class="mock-preview-line"></span>
                                  <span class="mock-preview-line mock-preview-line--short"></span>
                                  <span class="mock-preview-block"></span>
                                </div>
                              );
                            case 'previewDual':
                              return (
                                <div class="mock-preview-dual">
                                  <div class="mock-preview-frame mock-preview-frame--mobile">
                                    <span class="mock-preview-frame-label">{block.mobileLabel ?? 'Mobile'}</span>
                                    <span class="mock-preview-line"></span>
                                    <span class="mock-preview-line mock-preview-line--short"></span>
                                    <span class="mock-preview-block"></span>
                                  </div>
                                  <div class="mock-preview-frame mock-preview-frame--desktop">
                                    <span class="mock-preview-frame-label">{block.desktopLabel ?? 'Desktop'}</span>
                                    <span class="mock-preview-line"></span>
                                    <span class="mock-preview-line mock-preview-line--short"></span>
                                    <span class="mock-preview-block"></span>
                                  </div>
                                </div>
                              );
                            case 'e2e':
                              return (
                                <p class="mock-e2e">
                                  <img class="mock-e2e-check" src="/icons/checkmark.svg" alt="" aria-hidden="true" />
                                  {block.text}
                                </p>
                              );
                            case 'reactions':
                              return (
                                <div class="mock-reactions">
                                  {block.items.map((r) => (
                                    <span class={'mock-reaction' + (r.active ? ' mock-reaction--active flow-thumb' : '')}>{r.label}</span>
                                  ))}
                                </div>
                              );
                            case 'hint':
                              return <p class="mock-hint">{block.text}</p>;
                            case 'status':
                              return (
                                <p class="mock-status">
                                  <span class="mock-spinner" aria-hidden="true"></span>
                                  <span class="mock-pulse"></span>
                                  {block.text}
                                </p>
                              );
                            case 'prTitle':
                              return <p class="mock-pr-title">{block.text}</p>;
                            case 'verdict':
                              return <div class={`mock-verdict ${block.className}`}>{block.text}</div>;
                            case 'deploy':
                              return (
                                <div class="mock-deploy" aria-hidden="true">
                                  <span class="mock-deploy-fill"></span>
                                </div>
                              );
                            case 'deployLabel':
                              return (
                                <p class="mock-deploy-label" aria-hidden="true">
                                  <img class="mock-deploy-check" src="/icons/checkmark.svg" alt="" aria-hidden="true" />
                                  {block.text}
                                </p>
                              );
                            case 'liveBadge':
                              return <p class="mock-badge mock-badge--live">{block.text}</p>;
                            default:
                              return null;
                          }
                        })
                      }
                    </div>
                    )}
                  </div>
                </div>
              ))
            }
              </div>
            </div>

            <!-- Slideshow controls — prev/next arrows, visible step counter, dot indicator -->
            <div class="steps-controls">
              <button
                type="button"
                class="step-nav"
                id="step-prev"
                aria-label={howItWorks.data.prevStepLabel}
              >
                <span class="nav-arrow" style="--nav-arrow-mask: url('/icons/chevron-left.svg')" aria-hidden="true"></span>
              </button>
              <span class="step-counter" id="step-counter" aria-live="polite"></span>
              <div class="step-dots" id="step-dots" role="tablist" aria-label={howItWorks.data.stepNavAriaLabel}>
                {
                  steps.map((step, i) => (
                    <button
                      type="button"
                      class={`step-dot${i === 0 ? ' is-active' : ''}`}
                      aria-label={howItWorks.data.dotAriaLabelTemplate.replace('{n}', String(i + 1)).replace('{total}', String(steps.length))}
                      aria-selected={i === 0 ? 'true' : 'false'}
                    ></button>
                  ))
                }
              </div>
              <button
                type="button"
                class="step-nav"
                id="step-next"
                aria-label={howItWorks.data.nextStepLabel}
              >
                <span class="nav-arrow" style="--nav-arrow-mask: url('/icons/chevron-right.svg')" aria-hidden="true"></span>
              </button>
            </div>
          </div>
        </div>
      </section>

      /* ============ LOOP STATES ============ */
      <section class="loop" id="loop-states" aria-label={loopStatesHeader.data.ariaLabel}>
        <div class="container">
          <h2 id="loop-states-title">{loopStatesHeader.data.title}</h2>
          <p class="section-sub">
            {loopStatesHeader.data.sub}
          </p>

          <ul class="loop-legend" aria-hidden="true">
            <li><span class="legend-swatch legend-swatch--autonomous"></span> Autonomous</li>
            <li><span class="legend-swatch legend-swatch--human"></span> You decide</li>
            <li><span class="legend-swatch legend-swatch--terminal"></span> Terminal</li>
          </ul>

          <ol class="loop-flow" aria-labelledby="loop-states-title">
            {
              loopStates
                .filter((s) => s.data.order !== 9)
                .map((s) => (
                  <li class={`loop-node loop-node--${s.data.type}`}>
                    <span class="loop-node__num" aria-hidden="true">{s.data.order}</span>
                    <div class="loop-node__body">
                      <div>
                        <span class="loop-node__chip">{s.data.label}</span>
                        <span class="loop-node__type">{s.data.typeLabel}</span>
                      </div>
                      <p class="loop-node__desc">{s.data.description}</p>
                    </div>
                  </li>
                ))
            }
          </ol>

          {/* Escalation branch — pulled out of the sequence so it clearly
              branches off the main path rather than sitting in it. */}
          <div class="loop-branch" aria-label={loopStates.find((s) => s.data.order === 9).data.label}>
            <div class="loop-branch__join" aria-hidden="true"></div>
            <p class="loop-branch__tag">Escalation branch — exits the loop</p>
            <div class="loop-node loop-node--escalation loop-node--terminal">
              <span class="loop-node__num" aria-hidden="true">{loopStates.find((s) => s.data.order === 9).data.order}</span>
              <div class="loop-node__body">
                <div>
                  <span class="loop-node__chip">{loopStates.find((s) => s.data.order === 9).data.label}</span>
                  <span class="loop-node__type">{loopStates.find((s) => s.data.order === 9).data.typeLabel}</span>
                </div>
                <p class="loop-node__desc">{loopStates.find((s) => s.data.order === 9).data.description}</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ WHY BOUCLE ============ -->
      <section class="why" id="why-boucle" aria-labelledby="why-title">
        <div class="container">
          <h2 id="why-title">{whyBoucle.data.title}</h2>
          <p class="section-sub">
            {whyBoucle.data.sub}
          </p>

          <div class="cards">
            <div class="card card--featured">
              <div class="card-head">
                <img class="card-icon" src={cards[0].data.icon} alt="" aria-hidden="true" />
                <h3>{cards[0].data.title}</h3>
              </div>
              <p class="pain"><span class="remove" aria-hidden="true"><img src="/icons/close-x.svg" alt="" aria-hidden="true" /></span><span class="pain-text">{cards[0].data.pain}</span></p>
              <p class="answer">{cards[0].data.answer}</p>
            </div>

            <div class="card">
              <div class="card-head">
                <img class="card-icon" src={cards[1].data.icon} alt="" aria-hidden="true" />
                <h3>{cards[1].data.title}</h3>
              </div>
              <p class="pain"><span class="remove" aria-hidden="true"><img src="/icons/close-x.svg" alt="" aria-hidden="true" /></span><span class="pain-text">{cards[1].data.pain}</span></p>
              <p class="answer">{cards[1].data.answer}</p>
            </div>

            <div class="card">
              <div class="card-head">
                <img class="card-icon" src={cards[2].data.icon} alt="" aria-hidden="true" />
                <h3>{cards[2].data.title}</h3>
              </div>
              <p class="pain"><span class="remove" aria-hidden="true"><img src="/icons/close-x.svg" alt="" aria-hidden="true" /></span><span class="pain-text">{cards[2].data.pain}</span></p>
              <p class="answer">{cards[2].data.answer}</p>
            </div>

            <div class="card">
              <div class="card-head">
                <img class="card-icon" src={cards[3].data.icon} alt="" aria-hidden="true" />
                <h3>{cards[3].data.title}</h3>
              </div>
              <p class="pain"><span class="remove" aria-hidden="true"><img src="/icons/close-x.svg" alt="" aria-hidden="true" /></span><span class="pain-text">{cards[3].data.pain}</span></p>
              <p class="answer">{cards[3].data.answer}</p>
            </div>

            <div class="card">
              <div class="card-head">
                <img class="card-icon" src={cards[4].data.icon} alt="" aria-hidden="true" />
                <h3>{cards[4].data.title}</h3>
              </div>
              <p class="pain"><span class="remove" aria-hidden="true"><img src="/icons/close-x.svg" alt="" aria-hidden="true" /></span><span class="pain-text">{cards[4].data.pain}</span></p>
              <p class="answer">{cards[4].data.answer}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ QUICK START ============ -->
      <section class="quick" id="quick-start" aria-labelledby="quick-title">
        <div class="container">
          <h2 id="quick-title">{quickStart.data.title}</h2>
          <p class="section-sub">
            {quickStart.data.sub}
          </p>

          <div class="quick-toggle" role="tablist" aria-label={quickStart.data.tablistAriaLabel}>
            <button class="toggle-btn active" role="tab" aria-selected="true" data-tab="oneliner">{quickStart.data.onelinerTab}</button>
            <button class="toggle-btn" role="tab" aria-selected="false" data-tab="prompt">{quickStart.data.promptTab}</button>
          </div>

          <div class="quick-panels">
            <div class="quick-panel active" role="tabpanel" data-panel="oneliner">
              <pre class="code"><code>{quickStart.data.onelinerCode}</code></pre>
              <button class="copy-btn" data-copy="oneliner" data-label={quickStart.data.copyLabel} data-copied={quickStart.data.copiedLabel} data-failed={quickStart.data.failedLabel}>{quickStart.data.copyLabel}</button>
            </div>
            <div class="quick-panel" role="tabpanel" data-panel="prompt">
              <pre class="code"><code>{quickStart.data.promptCode}</code></pre>
              <button class="copy-btn" data-copy="prompt" data-label={quickStart.data.copyLabel} data-copied={quickStart.data.copiedLabel} data-failed={quickStart.data.failedLabel}>{quickStart.data.copyLabel}</button>
            </div>
          </div>

          <div class="quick-transition">
            <div class="num">{quickStart.data.transitionNum}</div>
            <p>{quickStart.data.transitionPrefix} <code>{quickStart.data.transitionTag}</code> {quickStart.data.transitionSuffix}</p>
          </div>

          <a class="quick-link" href={quickStart.data.docsHref}>
            {quickStart.data.docsLabel}
          </a>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer>
      <img class="footer-logo" src={footer.data.logo} alt="" aria-hidden="true" />
      <p class="footer-made">{footer.data.madePrefix} <a href={footer.data.madeHref}>{footer.data.madeLabel}</a></p>
      <nav class="footer-links" aria-label={footer.data.navAriaLabel}>
        {
          footer.data.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))
        }
      </nav>
      <p class="footer-icons">{footer.data.iconsPrefix} <a href={footer.data.iconsHref}>{footer.data.iconsLabel}</a></p>
    </footer>

    <script>
      // Card reveal animation — fades cards in when they enter the viewport.
      const cardObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              cardObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 }
      );
      document.querySelectorAll('.card').forEach((el) => cardObserver.observe(el));

      // Strike-through animation for pain points — triggers when card enters viewport.
      const painObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('strike');
              painObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 }
      );
      document.querySelectorAll('.pain-text').forEach((el) => painObserver.observe(el));

      // Quickstart toggle — switch between Oneliner and Prompt panels.
      document.querySelectorAll('.toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const tab = btn.dataset.tab;
          document.querySelectorAll('.toggle-btn').forEach((b) => {
            const isActive = b.dataset.tab === tab;
            b.classList.toggle('active', isActive);
            b.setAttribute('aria-selected', isActive);
          });
          document.querySelectorAll('.quick-panel').forEach((p) => {
            p.classList.toggle('active', p.dataset.panel === tab);
          });
        });
      });

      // Copy-to-clipboard for code panels.
      // Labels come from content via data attributes; if one is ever absent,
      // fall back to the label already rendered on the button (never a literal).
      document.querySelectorAll('.copy-btn').forEach((btn) => {
        const currentLabel = btn.textContent;
        const copyLabel = btn.dataset.label || currentLabel;
        const copiedLabel = btn.dataset.copied || currentLabel;
        const failedLabel = btn.dataset.failed || currentLabel;
        btn.addEventListener('click', async () => {
          const panel = btn.closest('.quick-panel');
          const code = panel.querySelector('code');
          try {
            await navigator.clipboard.writeText(code.textContent);
            btn.textContent = copiedLabel;
            btn.classList.add('copied');
            setTimeout(() => {
              btn.textContent = copyLabel;
              btn.classList.remove('copied');
            }, 2000);
          } catch {
            btn.textContent = failedLabel;
            setTimeout(() => {
              btn.textContent = copyLabel;
            }, 2000);
          }
        });
      });

      // ============ HOW-IT-WORKS SLIDESHOW ============
      // Shows one step at a time, loops 7 -> 1, auto-advances every 5s when
      // idle and in view, fully keyboard + reduced-motion accessible.
      (function () {
        const track = document.getElementById('steps-track');
        if (!track) return;
        const slides = Array.from(track.children).filter((el) =>
          el.classList.contains('step')
        );
        const total = slides.length;
        if (total < 2) return;

        const dotsWrap = document.getElementById('step-dots');
        const prevBtn = document.getElementById('step-prev');
        const nextBtn = document.getElementById('step-next');
        const counter = document.getElementById('step-counter');

        const reducedMotion =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let current = 0;
        let timer = null;
        let isSectionVisible = false;

        // Wire up the server-rendered dot indicator. The dots are part of
        // the static HTML (first one already .is-active), so with JS disabled
        // the active gold line for step 1 is still visible (progressive
        // enhancement). Here we only attach click handlers.
        const dots = Array.from(dotsWrap.querySelectorAll('.step-dot'));
        dots.forEach((dot, i) => {
          dot.addEventListener('click', () => goTo(i, true));
        });

        function goTo(index, userInitiated) {
          if (index < 0) index = total - 1; // wrap backward
          if (index >= total) index = 0; // wrap forward (loop to first)
          current = index;
          track.classList.add('is-animating');
          track.style.transform = `translateX(-${current * 100}%)`;
          renderState();
          // Always reschedule the auto-play timer — on user navigation AND on
          // each auto-advance — so the slideshow keeps looping through all
          // steps while idle and in view (issue #41 autoplay criterion).
          restartAutoplay();
        }

        function renderState() {
          slides.forEach((slide, i) => {
            slide.setAttribute('aria-hidden', i === current ? 'false' : 'true');
          });
          dots.forEach((dot, i) => {
            dot.classList.toggle('is-active', i === current);
            dot.setAttribute('aria-selected', i === current ? 'true' : 'false');
          });
          if (counter) counter.textContent = `${current + 1} / ${total}`;
        }

        function restartAutoplay() {
          stopAutoplay();
          if (reducedMotion) return; // never auto-play under reduced motion
          timer = window.setTimeout(() => {
            goTo(current + 1, false);
          }, 5000);
        }

        function stopAutoplay() {
          if (timer) {
            window.clearTimeout(timer);
            timer = null;
          }
        }

        // Keyboard navigation responds when the section is visible in the
        // viewport (issue #41: "press ArrowRight/ArrowLeft advances") OR when
        // focus is inside the section. preventDefault stops the page from
        // scrolling horizontally.
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
          const target = e.target;
          const focusInside =
            target && typeof target.closest === 'function' &&
            target.closest('#how-it-works');
          if (!isSectionVisible && !focusInside) return;
          e.preventDefault();
          if (e.key === 'ArrowRight') goTo(current + 1, true);
          else goTo(current - 1, true);
        });

        prevBtn.addEventListener('click', () => goTo(current - 1, true));
        nextBtn.addEventListener('click', () => goTo(current + 1, true));

        // Pause autoplay when the section leaves the viewport.
        const section = track.closest('.how');
        if (section && 'IntersectionObserver' in window) {
          const sectionObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                isSectionVisible = entry.isIntersecting;
                if (entry.isIntersecting) restartAutoplay();
                else stopAutoplay();
              });
            },
            { threshold: 0.2 }
          );
          sectionObserver.observe(section);
        } else if (!reducedMotion) {
          restartAutoplay();
        }

        renderState();
      })();
    </script>
  </body>
</html>
