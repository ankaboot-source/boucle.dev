---
// boucle.dev — landing page
// Afro-futurist + Goldilocks. Single-page static site, no raster images.
// Conforms to VISUAL-CHARTER.md (tokens, components, content directives).
// English copy (public, global audience). Self-hosted fonts (no CDN, GDPR).
const title = 'boucle — zero-code autonomous product builder';
const description =
  "Building a product is child's play. From a ticket in your forge to a feature in production. boucle works while you sleep, you intervene at decision points.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a12" />
    <link rel="icon" type="image/svg+xml" href="/boucle.dev/favicon.svg" />
    <style>
      /* Self-hosted fonts — no Google Fonts CDN (GDPR).
         Unbounded (display) and Sora (body) are variable fonts (wght axis),
         so a single woff2 serves the whole weight range. Space Mono is static. */
      @font-face {
        font-family: 'Unbounded';
        font-style: normal;
        font-weight: 200 900;
        font-display: swap;
        src: url('/boucle.dev/fonts/unbounded.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Sora';
        font-style: normal;
        font-weight: 400 800;
        font-display: swap;
        src: url('/boucle.dev/fonts/sora.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Space Mono';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/boucle.dev/fonts/space-mono-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Space Mono';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/boucle.dev/fonts/space-mono-700.woff2') format('woff2');
      }

      :root {
        --surface-base: #0a0a12;
        --bg-secondary: #12121f;
        --surface-raised: #1a1a2e;
        --accent: #f5c842;
        --accent-gold-dim: #c9a233;
        --accent-violet: #7b2ff7;
        --accent-cyan: #00e5ff;
        --text-primary: #f0f0f5;
        --text-secondary: #a0a0b8;
        --text-gold: #f5c842;
        --border: rgba(245, 200, 66, 0.15);
        --glow-gold: rgba(245, 200, 66, 0.3);
        --glow-violet: rgba(123, 47, 247, 0.25);
        --font-display: 'Unbounded', 'Sora', sans-serif;
        --font-body: 'Sora', system-ui, sans-serif;
        --font-mono: 'Space Mono', monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--surface-base);
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* Skip link for keyboard users */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: var(--accent);
        color: var(--surface-base);
        font-weight: 600;
        text-decoration: none;
        border-radius: 999px;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
      }

      a {
        color: var(--accent-cyan);
      }
      a:hover {
        color: var(--accent);
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      section {
        padding: clamp(3rem, 8vw, 6rem) 1.5rem;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        margin: 0 0 1rem;
        line-height: 1.15;
      }

      h2 {
        font-size: clamp(1.8rem, 4vw, 3rem);
        font-weight: 600;
        text-align: center;
      }

      .section-sub {
        text-align: center;
        color: var(--text-secondary);
        max-width: 640px;
        margin: 0 auto 3rem;
      }

      /* ============ HERO ============ */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        background: linear-gradient(180deg, var(--surface-base), var(--bg-secondary));
        padding: 4rem 1.5rem;
      }

      .hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        animation: glow-pulse 4s ease-in-out infinite;
      }
      .hero-glow--violet {
        width: 480px;
        height: 480px;
        background: var(--glow-violet);
        top: -120px;
        left: -120px;
      }
      .hero-glow--gold {
        width: 420px;
        height: 420px;
        background: var(--glow-gold);
        bottom: -140px;
        right: -120px;
        animation-delay: 2s;
      }

      @keyframes glow-pulse {
        0%,
        100% {
          opacity: 0.5;
          transform: scale(1);
        }
        50% {
          opacity: 1;
          transform: scale(1.08);
        }
      }

      /* Subtle kente/adinkra-inspired geometric band (Sahelian motif).
         Decorative only, low opacity, aria-hidden, no motion. */
      .hero-motif {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: min(720px, 90vw);
        height: 14px;
        opacity: 0.35;
        pointer-events: none;
        background-image: repeating-linear-gradient(
          90deg,
          var(--accent) 0 6px,
          transparent 6px 12px,
          var(--accent-violet) 12px 16px,
          transparent 16px 22px,
          var(--accent-cyan) 22px 26px,
          transparent 26px 32px
        );
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
      }

      .hero-inner {
        position: relative;
        z-index: 1;
        max-width: 760px;
      }

      .logo-lockup {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 2rem;
      }
      .logo-lockup svg {
        width: 56px;
        height: 56px;
      }
      .wordmark {
        font-family: var(--font-display);
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-gold);
        letter-spacing: 0.02em;
      }

      .hero h1 {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 700;
        margin-bottom: 1.25rem;
      }

      .hero-sub {
        font-size: clamp(1.05rem, 2.2vw, 1.35rem);
        color: var(--text-secondary);
        max-width: 620px;
        margin: 0 auto 2.5rem;
      }

      .hero-ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
      }

      .btn {
        display: inline-block;
        padding: 0.85rem 1.75rem;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.05rem;
        text-decoration: none;
        border-radius: 999px;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      }
      .btn--primary {
        background: var(--accent);
        color: var(--surface-base);
      }
      .btn--primary:hover {
        background: var(--accent-gold-dim);
        color: var(--surface-base);
      }
      .btn--ghost {
        border: 1px solid var(--border);
        color: var(--text-primary);
      }
      .btn--ghost:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      /* ============ HOW IT WORKS ============ */
      .how {
        background: var(--surface-base);
      }

      .steps {
        position: relative;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        margin-top: 2rem;
      }

      /* The "boucle" — a visible gold dotted connector line.
         Vertical on mobile, horizontal on desktop. */
      .steps::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 28px;
        width: 0;
        border-left: 2px dashed var(--accent);
        opacity: 0.55;
      }

      .step {
        position: relative;
        display: flex;
        gap: 1.25rem;
        align-items: flex-start;
        padding-left: 0;
      }

      .step-icon {
        flex: 0 0 auto;
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 0;
        color: var(--accent);
      }
      .step-icon svg {
        width: 28px;
        height: 28px;
      }

      .step-body h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 0.35rem;
      }
      .step-body p {
        margin: 0;
        color: var(--text-secondary);
      }

      /* Validation flow badges — bring the "flux des choses qui se valident"
         to life: thumb up, verdict, deploy, infinite loop. Decorative only,
         aria-hidden, CSS @keyframes only (no JS). Durations 300–800ms with
         ease-out, except the ambient loop (3s). The badge reserves space
         (inline-flex) so nothing shifts when it appears. */
      .step-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.75rem;
        padding: 0.22rem 0.6rem;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: var(--bg-secondary);
        color: var(--text-secondary);
        opacity: 0;
        animation-fill-mode: both;
        will-change: opacity, transform;
      }
      .step-badge svg {
        width: 14px;
        height: 14px;
      }

      /* 1. Loop (Issue) — ambient infinite pulse of the ∞ motif, no spin/bounce */
      .badge--loop {
        color: var(--accent);
        border-color: var(--accent);
        animation: loop-pulse 3s ease-in-out infinite;
      }
      @keyframes loop-pulse {
        0%,
        100% {
          opacity: 0.55;
          transform: scale(1);
        }
        50% {
          opacity: 1;
          transform: scale(1.06);
        }
      }

      /* 2. Thumb up (Spec) — human approval fade-in-up */
      .badge--thumb {
        color: var(--accent);
        border-color: var(--accent);
        animation: fade-in-up 0.6s ease-out both;
        animation-delay: 0.4s;
      }
      @keyframes fade-in-up {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* 3. Verdict (Implement) — PASS fade-in after the thumb */
      .badge--verdict {
        color: var(--accent-cyan);
        border-color: rgba(0, 229, 255, 0.35);
        animation: fade-in 0.6s ease-out both;
        animation-delay: 1.1s;
      }
      @keyframes fade-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      /* 4. Deploy (Deploy) — progress bar fill + checkmark */
      .badge--deploy {
        color: var(--accent);
        border-color: var(--accent);
        animation: fade-in 0.6s ease-out both;
        animation-delay: 1.8s;
      }
      .badge--deploy .deploy-track {
        width: 34px;
        height: 4px;
        border-radius: 999px;
        background: var(--surface-raised);
        overflow: hidden;
      }
      .badge--deploy .deploy-fill {
        display: block;
        height: 100%;
        width: 100%;
        background: var(--accent);
        transform-origin: left;
        animation: deploy-fill 0.6s ease-out both;
        animation-delay: 1.9s;
      }
      @keyframes deploy-fill {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }

      /* ============ WHY BOUCLE ============ */
      .why {
        background: var(--bg-secondary);
      }

      .cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .card {
        background: var(--surface-base);
        border: 1px solid var(--border);
        border-radius: 0;
        padding: 1.75rem;
      }
      .card h3 {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 0.75rem;
      }
      .card .pain {
        color: var(--text-secondary);
        margin: 0 0 0.5rem;
      }
      .card .answer {
        color: var(--text-primary);
        margin: 0;
      }
      .card .arrow {
        color: var(--accent-violet);
        margin: 0 0 0.5rem;
        font-family: var(--font-mono);
      }

      /* Featured promise — "Lives in your forge", the key differentiator.
         Spans the full card grid width and gets a distinct gold treatment. */
      .card--featured {
        grid-column: 1 / -1;
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent), 0 0 24px var(--glow-gold);
        padding: 2.25rem;
      }
      .card--featured h3 {
        font-size: 1.5rem;
      }

      .why-positioning {
        margin: 2.5rem auto 0;
        max-width: 640px;
        text-align: center;
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
        font-weight: 600;
        color: var(--text-gold);
      }

      /* ============ QUICK START ============ */
      .quick {
        background: var(--surface-base);
      }

      .quick-install {
        max-width: 720px;
        margin: 0 auto;
      }
      .quick-install .label {
        font-family: var(--font-mono);
        color: var(--accent);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }
      .code {
        background: var(--surface-raised);
        border-radius: 0;
        padding: 0.9rem 1rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--accent-cyan);
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-word;
        margin: 0;
      }

      /* The install→usage transition: a visually distinct panel that marks
         the shift from "setup tooling" to "daily usage in your own forge".
         Gold border + raised background per charter §2 tokens. */
      .quick-transition {
        max-width: 720px;
        margin: 1.5rem auto 0;
        background: var(--bg-secondary);
        border: 1px solid var(--accent);
        border-radius: 0;
        padding: 1.5rem;
        box-shadow: 0 0 24px var(--glow-gold);
      }
      .quick-transition .num {
        font-family: var(--font-mono);
        color: var(--accent);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }
      .quick-transition p {
        margin: 0;
        color: var(--text-primary);
      }
      .quick-transition code {
        font-family: var(--font-mono);
        color: var(--accent);
        background: var(--surface-raised);
        padding: 0.1rem 0.35rem;
        border-radius: 0;
      }

      .quick-link {
        display: inline-block;
        margin-top: 2rem;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
      }
      .quick-link:hover {
        color: var(--accent-gold-dim);
      }

      /* ============ FOOTER ============ */
      footer {
        background: var(--surface-base);
        border-top: 1px solid var(--border);
        padding: 2.5rem 1.5rem;
        text-align: center;
      }
      .footer-made {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin: 0 0 1rem;
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        justify-content: center;
        font-size: 0.9rem;
      }
      .footer-links a {
        color: var(--text-secondary);
        text-decoration: none;
      }
      .footer-links a:hover {
        color: var(--accent);
      }

      /* ============ RESPONSIVE ============ */
      @media (min-width: 768px) {
        .cards {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (min-width: 1024px) {
        .steps {
          grid-template-columns: repeat(4, 1fr);
          gap: 1.5rem;
        }
        /* Horizontal dotted connector across the 4 steps */
        .steps::before {
          top: 28px;
          bottom: auto;
          left: 0;
          right: 0;
          width: auto;
          height: 0;
          border-left: none;
          border-top: 2px dashed var(--accent);
        }
        .step {
          flex-direction: column;
          align-items: center;
          text-align: center;
          padding: 0;
        }
        .step-body p {
          max-width: 220px;
          margin: 0 auto;
        }
        .cards {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      /* ============ REDUCED MOTION ============ */
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .hero-glow {
          animation: none;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-delay: 0ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main">
      <!-- ============ HERO ============ -->
      <section class="hero" aria-label="boucle — introduction">
        <div class="hero-glow hero-glow--violet" aria-hidden="true"></div>
        <div class="hero-glow hero-glow--gold" aria-hidden="true"></div>
        <div class="hero-motif" aria-hidden="true"></div>

        <div class="hero-inner">
          <div class="logo-lockup">
            <!-- Figurative afro-futurist logo: a face with a golden afro
                 (full circle = the "boucle"), gold hoop créoles, an
                 afrofuturist gold visor with the infinity loop (∞) woven
                 into the bridge. Inline SVG, no raster. -->
            <svg
              viewBox="0 0 100 100"
              role="img"
              aria-label="boucle logo — afrofuturist face with golden afro, créoles, and sunglasses"
              fill="none"
            >
              <!-- Afro: full gold circle (the "boucle") -->
              <circle cx="50" cy="50" r="46" fill="var(--accent, #f5c842)" />
              <!-- Face: figurative silhouette -->
              <path
                d="M50 30
                   C 40 30, 34 36, 34 44
                   L 34 60
                   C 34 70, 40 78, 50 78
                   C 60 78, 66 70, 66 60
                   L 66 44
                   C 66 36, 60 30, 50 30
                   Z"
                fill="var(--surface-base, #0a0a12)"
              />
              <!-- Sunglasses: afrofuturist gold visor -->
              <rect x="36" y="44" width="28" height="10" rx="5" fill="var(--accent, #f5c842)" />
              <!-- Infinity loop (∞) woven into the visor bridge -->
              <circle cx="46" cy="49" r="3.5" fill="var(--surface-base, #0a0a12)" />
              <circle cx="54" cy="49" r="3.5" fill="var(--surface-base, #0a0a12)" />
              <!-- Créoles: gold hoop earrings (dark rings = hoop openings) -->
              <circle cx="30" cy="62" r="5" stroke="var(--surface-base, #0a0a12)" stroke-width="2.5" />
              <circle cx="70" cy="62" r="5" stroke="var(--surface-base, #0a0a12)" stroke-width="2.5" />
            </svg>
            <span class="wordmark">boucle</span>
          </div>

          <h1>Building a product is child's play</h1>
          <p class="hero-sub">
            From a ticket in your forge to a feature in production. boucle
            works while you sleep, you intervene at decision points.
          </p>

          <div class="hero-ctas">
            <a class="btn btn--primary" href="#quick-start">Get started</a>
            <a class="btn btn--ghost" href="#how-it-works">How it works</a>
          </div>
        </div>
      </section>

      <!-- ============ HOW IT WORKS ============ -->
      <section class="how" id="how-it-works" aria-labelledby="how-title">
        <div class="container">
          <h2 id="how-title">How it works</h2>
          <p class="section-sub">
            Four steps, one loop. You stay in your forge, boucle does the rest.
          </p>

          <div class="steps">
            <div class="step">
              <div class="step-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 3" />
                </svg>
              </div>
              <div class="step-body">
                <h3>Issue</h3>
                <p>You create a ticket in your forge.</p>
                <span class="step-badge badge--loop" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="8" cy="12" r="3.5" />
                    <circle cx="16" cy="12" r="3.5" />
                  </svg>
                  loop
                </span>
              </div>
            </div>

            <div class="step">
              <div class="step-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M4 6h16M4 12h16M4 18h10" />
                </svg>
              </div>
              <div class="step-body">
                <h3>Spec</h3>
                <p>boucle analyzes and writes the spec. You approve it.</p>
                <span class="step-badge badge--thumb" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M7 11v8M9 11l1-4a2 2 0 0 1 2-2h1.5a1.5 1.5 0 0 1 1.5 1.7l-.4 2.3H19a1 1 0 0 1 1 1.2l-.8 4a1 1 0 0 1-1 .8H7" />
                  </svg>
                  approved
                </span>
              </div>
            </div>

            <div class="step">
              <div class="step-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 3v12M7 8l5-5 5 5" />
                  <path d="M4 21h16" />
                </svg>
              </div>
              <div class="step-body">
                <h3>Implement</h3>
                <p>boucle implements and deploys a preview.</p>
                <span class="step-badge badge--verdict" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 12l4 4L18 6" />
                  </svg>
                  pass
                </span>
              </div>
            </div>

            <div class="step">
              <div class="step-icon" aria-hidden="true">
