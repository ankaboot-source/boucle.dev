---
// boucle.dev — landing page
// Afro-futurist + Goldilocks. Single-page static site. The only raster assets
// are the brand logo: a PNG poster (public/boucle-logo.png) and an animated
// MP4 (public/boucle-logo.mp4) in the hero. Everything else is CSS/inline SVG.
// Conforms to DESIGN.md (tokens, components, content directives).
// English copy (public, global audience). Self-hosted fonts (no CDN, GDPR).
// All user-facing text is extracted to src/content/ collections (issue #39);
// this file only imports and renders them. CSS, JS, SVG markup and structural
// HTML remain inline here.
import { getCollection } from 'astro:content';

const hero = (await getCollection('hero'))[0];
const howItWorks = (await getCollection('howItWorks'))[0];
const steps = (await getCollection('steps')).sort((a, b) => a.data.order - b.data.order);
const whyBoucle = (await getCollection('whyBoucle'))[0];
const cards = (await getCollection('cards')).sort((a, b) => a.data.order - b.data.order);
const quickStart = (await getCollection('quickStart'))[0];
const footer = (await getCollection('footer'))[0];

const title = hero.data.metaTitle;
const description = hero.data.metaDescription;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    <link rel="icon" type="image/svg+xml" href="/boucle.dev/favicon.svg" />
    <style>
      /* Self-hosted fonts — no Google Fonts CDN (GDPR).
         Unbounded (display) and Sora (body) are variable fonts (wght axis),
         so a single woff2 serves the whole weight range. Space Mono is static. */
      @font-face {
        font-family: 'Unbounded';
        font-style: normal;
        font-weight: 200 900;
        font-display: swap;
        src: url('/boucle.dev/fonts/unbounded.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Sora';
        font-style: normal;
        font-weight: 400 800;
        font-display: swap;
        src: url('/boucle.dev/fonts/sora.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Space Mono';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/boucle.dev/fonts/space-mono-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Space Mono';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/boucle.dev/fonts/space-mono-700.woff2') format('woff2');
      }

      :root {
        /* Forge surfaces — GitHub-dark-inspired (Primer Product UI), per DESIGN §2. */
        --surface-base: #0d1117;
        --bg-secondary: #161b22;
        --surface-raised: #21262d;
        /* Afro-futurist accents — preserved, unchanged. */
        --accent: #f5c842;
        --accent-gold-dim: #c9a233;
        --accent-violet: #7b2ff7;
        --accent-cyan: #00e5ff;
        --text-primary: #f0f0f5;
        --text-secondary: #a0a0b8;
        --text-gold: #f5c842;
        --border: rgba(245, 200, 66, 0.15);
        --border-neutral: rgba(255, 255, 255, 0.08);
        --glow-gold: rgba(245, 200, 66, 0.3);
        --glow-violet: rgba(123, 47, 247, 0.25);
        /* Forge radii & shadows (Primer/Pajamas) */
        --radius: 6px;
        --shadow-subtle: 0 1px 3px rgba(0, 0, 0, 0.3);
        --font-display: 'Unbounded', 'Sora', sans-serif;
        --font-body: system-ui, 'Sora', sans-serif;
        --font-mono: 'Space Mono', monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--surface-base);
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* Skip link for keyboard users */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: var(--accent);
        color: var(--surface-base);
        font-weight: 600;
        text-decoration: none;
        border-radius: var(--radius);
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
      }

      a {
        color: var(--accent-cyan);
      }
      a:hover {
        color: var(--accent);
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      section {
        padding: clamp(3rem, 8vw, 6rem) 1.5rem;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        margin: 0 0 1rem;
        line-height: 1.15;
      }

      h2 {
        font-size: clamp(1.8rem, 4vw, 3rem);
        font-weight: 600;
        text-align: center;
      }

      .section-sub {
        text-align: center;
        color: var(--text-secondary);
        max-width: 640px;
        margin: 0 auto 3rem;
      }

      /* ============ HERO ============ */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        background: linear-gradient(180deg, var(--surface-base), var(--bg-secondary));
        padding: 4rem 1.5rem;
      }

      .hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        animation: glow-pulse 4s ease-in-out infinite;
      }
      .hero-glow--violet {
        width: 480px;
        height: 480px;
        background: var(--glow-violet);
        top: -120px;
        left: -120px;
      }
      .hero-glow--gold {
        width: 420px;
        height: 420px;
        background: var(--glow-gold);
        bottom: -140px;
        right: -120px;
        animation-delay: 2s;
      }

      @keyframes glow-pulse {
        0%,
        100% {
          opacity: 0.5;
          transform: scale(1);
        }
        50% {
          opacity: 1;
          transform: scale(1.08);
        }
      }

      /* Subtle kente/adinkra-inspired geometric band (Sahelian motif).
         Decorative only, low opacity, aria-hidden, no motion. */
      .hero-motif {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: min(720px, 90vw);
        height: 14px;
        opacity: 0.35;
        pointer-events: none;
        background-image: repeating-linear-gradient(
          90deg,
          var(--accent) 0 6px,
          transparent 6px 12px,
          var(--accent-violet) 12px 16px,
          transparent 16px 22px,
          var(--accent-cyan) 22px 26px,
          transparent 26px 32px
        );
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
      }

      .hero-inner {
        position: relative;
        z-index: 1;
        max-width: 1100px;
        width: 100%;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        align-items: center;
      }

      .hero-copy {
        max-width: 640px;
        margin: 0 auto;
      }

      .logo-lockup {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 2rem;
      }
      .wordmark {
        font-family: var(--font-display);
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-gold);
        letter-spacing: 0.02em;
      }

      .hero-logo-video {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .hero-logo-video video {
        width: min(340px, 70vw);
        height: auto;
        border-radius: 50%;
        display: block;
        box-shadow: 0 0 60px var(--glow-gold);
      }

      .hero h1 {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 700;
        margin-bottom: 1.25rem;
      }

      .hero-sub {
        font-size: clamp(1.05rem, 2.2vw, 1.35rem);
        color: var(--text-secondary);
        max-width: 620px;
        margin: 0 auto 2.5rem;
      }

      /* Forge badges — "Lives in your forge" visual cue (Primer/Pajamas look:
         6px radius, subtle neutral border, raised bg, small mono-ish font). */
      .forge-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        list-style: none;
        margin: 0 auto 2.5rem;
        padding: 0;
      }
      .forge-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.85rem;
        background: var(--surface-raised);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        box-shadow: var(--shadow-subtle);
        color: var(--text-secondary);
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-decoration: none;
        transition: color 0.2s ease, border-color 0.2s ease;
      }
      .forge-badge:hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .forge-badge svg {
        width: 16px;
        height: 16px;
        display: block;
      }

      .hero-ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
      }

      .btn {
        display: inline-block;
        padding: 0.85rem 1.75rem;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.05rem;
        text-decoration: none;
        border-radius: var(--radius);
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      }
      .btn--primary {
        background: var(--accent);
        color: var(--surface-base);
      }
      .btn--primary:hover {
        background: var(--accent-gold-dim);
        color: var(--surface-base);
      }
      .btn--ghost {
        border: 1px solid var(--border);
        color: var(--text-primary);
      }
      .btn--ghost:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      /* ============ HOW IT WORKS ============ */
      .how {
        background: var(--surface-base);
      }

      .steps {
        position: relative;
        margin-top: 2rem;
      }

      /* Slideshow viewport — a flex track shows exactly one step at a time.
         `overflow: hidden` keeps only the current slide visible, and with no
         JS transform the first step is shown (no flash of all steps, no blank
         container). The track height matches the tallest slide, so the
         container does not jump between steps. */
      .steps-track {
        display: flex;
        align-items: stretch;
        overflow: hidden;
      }
      .steps-track.is-animating {
        transition: transform 0.5s ease;
      }

      .step {
        position: relative;
        flex: 0 0 100%;
        max-width: 100%;
        min-width: 0;
        padding-left: 0;
      }

      /* Slideshow controls — prev/next arrows (44x44px touch targets) and a
         dot indicator. Dots are forge-radius squares, not circles (radius 50%
         is reserved for the hero glow blobs). */
      .steps-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        margin-top: 1.5rem;
      }

      .step-nav {
        flex: 0 0 auto;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-secondary);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        color: var(--text-primary);
        cursor: pointer;
        transition: border-color 0.2s ease, color 0.2s ease;
      }
      .step-nav:hover {
        border-color: var(--accent);
        color: var(--accent);
      }
      .step-nav:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .step-nav svg {
        width: 22px;
        height: 22px;
      }

      .step-dots {
        display: flex;
        gap: 0.5rem;
      }
      .step-dot {
        width: 14px;
        height: 6px;
        padding: 0;
        border: none;
        border-radius: var(--radius);
        background: var(--border-neutral);
        cursor: pointer;
        transition: background 0.2s ease;
      }
      .step-dot:hover {
        background: var(--accent-gold-dim);
      }
      .step-dot.is-active {
        background: var(--accent);
      }
      .step-dot:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .step-head {
        display: flex;
        gap: 1.25rem;
        align-items: flex-start;
      }

      .step-icon {
        flex: 0 0 auto;
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-secondary);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        color: var(--accent);
      }
      .step-icon svg {
        width: 28px;
        height: 28px;
      }

      .step-body h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 0.35rem;
      }
      .step-body p {
        margin: 0;
        color: var(--text-secondary);
      }

      /* Forge mini-mockup — pure HTML/CSS, no external images.
         Text tokens (primary/secondary) on bg-secondary/raised keep
         WCAG 2.1 AA contrast (>= 4.5:1). Decorative internals are
         aria-hidden; the mock carries a role="img" aria-label. */
      .forge-mock {
        margin-top: 1.25rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 0;
        overflow: hidden;
        text-align: left;
        font-size: 0.8rem;
        line-height: 1.4;
      }
      .mock-bar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.75rem;
        background: var(--surface-raised);
        border-bottom: 1px solid var(--border);
      }
      .mock-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--border);
      }
      .mock-url {
        color: var(--text-secondary);
        font-size: 0.7rem;
        margin-left: 0.25rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .mock-body {
        padding: 0.85rem 0.9rem;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        color: var(--text-secondary);
      }
      .mock-title {
        margin: 0;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-desc,
      .mock-meta,
      .mock-comment,
      .mock-hint,
      .mock-pr-title {
        margin: 0;
      }
      .mock-meta {
        font-size: 0.72rem;
      }
      .mock-badge {
        display: inline-block;
        width: fit-content;
        padding: 0.15rem 0.55rem;
        margin: 0;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border-radius: 999px;
      }
      .mock-badge--issue {
        color: var(--surface-base);
        background: var(--accent);
      }
      .mock-badge--live {
        color: var(--text-primary);
        background: rgba(0, 229, 255, 0.18);
        border: 1px solid rgba(0, 229, 255, 0.4);
      }
      .mock-avatar {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 999px;
        background: var(--text-secondary);
        vertical-align: middle;
        margin-right: 0.35rem;
      }
      .mock-avatar--gold {
        background: var(--accent);
      }
      .mock-author {
        margin: 0;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-preview {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0.6rem;
        background: var(--surface-base);
        border: 1px solid var(--border);
      }
      .mock-preview-line {
        display: block;
        height: 7px;
        background: var(--border);
      }
      .mock-preview-line--short {
        width: 60%;
      }
      .mock-preview-block {
        display: block;
        height: 42px;
        background: var(--surface-raised);
        border: 1px solid var(--border);
      }
      .mock-reactions {
        display: flex;
        gap: 0.5rem;
      }
      .mock-reaction {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.55rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 0.75rem;
        color: var(--text-secondary);
      }
      .mock-reaction--active {
        border-color: var(--accent);
        color: var(--accent);
      }
      .mock-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-spinner {
        width: 12px;
        height: 12px;
        border: 2px solid var(--border);
        border-top-color: var(--accent);
        border-radius: 999px;
        animation: mock-spin 0.9s linear infinite;
      }
      @keyframes mock-spin {
        to {
          transform: rotate(360deg);
        }
      }
      .mock-pulse {
        width: 9px;
        height: 9px;
        border-radius: 999px;
        background: var(--accent);
        animation: mock-pulse 1.4s ease-in-out infinite;
      }
      @keyframes mock-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.3;
        }
      }
      .mock-verdict {
        display: inline-block;
        width: fit-content;
        padding: 0.2rem 0.7rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        border-radius: 999px;
      }
      .mock-verdict--pass {
        color: var(--surface-base);
        background: var(--accent);
      }
      .mock-verdict--merged {
        color: var(--surface-base);
        background: var(--accent);
      }

      /* ============ VALIDATION FLOW ANIMATIONS ============ */
      /* Subtle gestures that bring the validation cycle to life.
         CSS-only, sequenced: thumb-up → verdict → deploy.
         The ambient loop pulse runs continuously in the hero. */
      .flow-thumb {
        animation: flow-fade-in-up 0.6s ease-out 0.3s both;
      }
      .flow-verdict {
        animation: flow-fade-in 0.6s ease-out 1s both;
      }
      .mock-deploy {
        display: block;
        height: 6px;
        margin: 0.6rem 0;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface-raised);
      }
      .mock-deploy-fill {
        display: block;
        height: 100%;
        transform-origin: left;
        transform: scaleX(0);
        background: var(--accent);
        border-radius: 999px;
        animation: deploy-fill 0.6s ease-out 1.7s both;
      }
      .mock-deploy-label {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.5rem;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-deploy-check {
        width: 11px;
        height: 11px;
        flex: none;
        color: var(--accent);
        animation: flow-fade-in 0.5s ease-out 2.1s both;
      }
      .loop-pulse {
        animation: loop-pulse 3s ease-in-out infinite;
      }
      @keyframes flow-fade-in-up {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes flow-fade-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      @keyframes deploy-fill {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }
      @keyframes loop-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.45;
        }
      }

      /* ============ LIVES IN YOUR FORGE ============ */
      .forge {
        background: var(--surface-base);
      }
      .forge-message {
        text-align: center;
        color: var(--text-primary);
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
        font-weight: 600;
        max-width: 640px;
        margin: 0 auto 3rem;
      }
      .forge-logos {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .forge-logos a {
        display: inline-flex;
        align-items: center;
        color: var(--text-primary);
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .forge-logos a:hover {
        color: var(--accent);
      }
      .forge-logos svg {
        width: clamp(120px, 20vw, 180px);
        height: auto;
        display: block;
      }

      /* ============ WHY BOUCLE ============ */
      .why {
        background: var(--bg-secondary);
      }

      .cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .card {
        background: var(--surface-base);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        box-shadow: var(--shadow-subtle);
        padding: 1.75rem;
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s ease, transform 0.6s ease, border-color 0.3s ease, box-shadow 0.3s ease;
      }
      .card.is-visible {
        opacity: 1;
        transform: translateY(0);
      }
      .card:hover {
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent), 0 0 24px var(--glow-gold);
      }
      .card-head {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
      }
      .card-icon {
        flex-shrink: 0;
        width: 2.5rem;
        height: 2.5rem;
        display: block;
      }
      .card h3 {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--accent);
        margin: 0;
      }
      .card .pain {
        color: var(--text-secondary);
        margin: 0 0 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .card .remove {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1rem;
        height: 1rem;
        color: var(--accent-violet);
      }
      .card .answer {
        color: var(--text-primary);
        margin: 0;
      }

      /* Featured promise — "Lives in your forge", the key differentiator.
         Spans the full card grid width and gets a distinct gold treatment. */
      .card--featured {
        grid-column: 1 / -1;
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent), 0 0 24px var(--glow-gold);
        padding: 2.25rem;
      }
      .card--featured h3 {
        font-size: 1.5rem;
      }

      .why-positioning {
        margin: 2.5rem auto 0;
        max-width: 640px;
        text-align: center;
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
        font-weight: 600;
        color: var(--text-gold);
      }

      /* ============ QUICK START ============ */
      .quick {
        background: var(--surface-base);
      }

      .quick-install {
        max-width: 720px;
        margin: 0 auto;
      }
      .quick-install .label {
        font-family: var(--font-mono);
        color: var(--accent);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }
      .code {
        background: var(--surface-raised);
        border-radius: var(--radius);
        padding: 0.9rem 1rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--accent-cyan);
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-word;
        margin: 0;
      }

      /* The install→usage transition: a visually distinct panel that marks
         the shift from "setup tooling" to "daily usage in your own forge".
         Gold border + raised background per charter §2 tokens. */
      .quick-transition {
        max-width: 720px;
        margin: 1.5rem auto 0;
        background: var(--bg-secondary);
        border: 1px solid var(--accent);
        border-radius: var(--radius);
        padding: 1.5rem;
        box-shadow: 0 0 24px var(--glow-gold);
      }
      .quick-transition .num {
        font-family: var(--font-mono);
        color: var(--accent);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }
      .quick-transition p {
        margin: 0;
        color: var(--text-primary);
      }
      .quick-transition code {
        font-family: var(--font-mono);
        color: var(--accent);
        background: var(--surface-raised);
        padding: 0.1rem 0.35rem;
        border-radius: var(--radius);
      }

      .quick-link {
        display: inline-block;
        margin-top: 2rem;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
      }
      .quick-link:hover {
        color: var(--accent-gold-dim);
      }

      /* ============ FOOTER ============ */
      footer {
        background: var(--surface-base);
        border-top: 1px solid var(--border);
        padding: 2.5rem 1.5rem;
        text-align: center;
      }
      .footer-made {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin: 0 0 1rem;
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        justify-content: center;
        font-size: 0.9rem;
      }
      .footer-links a {
        color: var(--text-secondary);
        text-decoration: none;
      }
      .footer-links a:hover {
        color: var(--accent);
      }
      .footer-icons {
        color: var(--text-secondary);
        font-size: 0.75rem;
        margin: 1rem 0 0;
      }
      .footer-icons a {
        color: var(--text-secondary);
        text-decoration: none;
      }
      .footer-icons a:hover {
        color: var(--accent);
      }

      /* ============ RESPONSIVE ============ */
      @media (min-width: 768px) {
        .cards {
          grid-template-columns: repeat(2, 1fr);
        }
        .forge-logos {
          flex-direction: row;
          justify-content: center;
          gap: 3rem;
        }
      }
      @media (min-width: 1024px) {
        .hero-inner {
          grid-template-columns: 1.2fr 1fr;
          text-align: left;
        }
        .hero-copy {
          margin: 0;
        }
        .hero-copy .hero-sub,
        .hero-ctas {
          justify-content: flex-start;
        }
        .hero-copy .hero-sub {
          margin-left: 0;
          margin-right: 0;
          text-align: left;
        }
        /* Slideshow shows one step at a time at every breakpoint; the step
           content becomes centered on wider screens. */
        .step-head {
          flex-direction: column;
          align-items: center;
          text-align: center;
        }
        .step-body p {
          max-width: 260px;
          margin: 0 auto;
        }
        .cards {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      /* ============ STRIKE-THROUGH ANIMATION (Why boucle pain points) ============
         A repeating-linear-gradient background draws a 2px violet line at the
         vertical center of each 1.6em line-height tile, so every wrapped line
         of text gets its own strike line (works on any number of lines). The
         reveal is animated by transitioning the background width from 0 to
         100%, preserving the left-to-right 1.4s ease-in-out scroll-reveal. */
      .pain-text {
        background-image: linear-gradient(
          to bottom,
          transparent 0,
          transparent calc(50% - 1px),
          var(--accent-violet) calc(50% - 1px),
          var(--accent-violet) calc(50% + 1px),
          transparent calc(50% + 1px)
        );
        background-size: 0 1.6em;
        background-repeat: repeat-y;
        transition: background-size 1.4s ease-in-out;
      }
      .pain-text.strike {
        background-size: 100% 1.6em;
      }

      /* ============ WHY BOUCLE SUBTITLE (gold positioning text) ============ */
      .why .section-sub {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--text-gold);
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
      }

      /* ============ HOW IT WORKS — OFFICIAL FORGE LOGOS ============ */
      .how-logos {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 2.5rem;
        list-style: none;
        margin: 0 auto 3rem;
        padding: 0;
      }
      .how-logos li {
        display: inline-flex;
        align-items: center;
      }
      .how-logos img {
        height: 36px;
        width: auto;
        display: block;
      }

      /* ============ QUICKSTART TOGGLE ============ */
      .quick-toggle {
        display: flex;
        max-width: 720px;
        margin: 0 auto;
      }
      .toggle-btn {
        padding: 0.5rem 1.5rem;
        background: var(--surface-raised);
        border: 1px solid var(--border-neutral);
        border-bottom: none;
        border-radius: var(--radius) var(--radius) 0 0;
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition:
          background-color 0.2s ease,
          color 0.2s ease,
          border-color 0.2s ease;
      }
      .toggle-btn.active {
        background: var(--accent);
        color: var(--surface-base);
        border-color: var(--accent);
      }
      .toggle-btn:not(.active):hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .quick-panels {
        max-width: 720px;
        margin: 0 auto;
      }
      .quick-panel {
        display: none;
      }
      .quick-panel.active {
        display: block;
      }
      .quick-panel .code {
        border-radius: 0 var(--radius) var(--radius) var(--radius);
        margin: 0;
      }
      .copy-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.75rem;
        padding: 0.4rem 1rem;
        background: transparent;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        cursor: pointer;
        transition:
          color 0.2s ease,
          border-color 0.2s ease;
      }
      .copy-btn:hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .copy-btn.copied {
        color: var(--accent);
        border-color: var(--accent);
      }

      /* ============ REDUCED MOTION ============ */
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .hero-glow {
          animation: none;
        }
        .hero-logo-video video {
          /* Autoplaying logo animation is motion — pause it and show the static
             PNG poster only when the user prefers reduced motion. */
          animation: none;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">{hero.data.skipLink}</a>

    <main id="main">
      <!-- ============ HERO ============ -->
      <section class="hero" aria-label={hero.data.sectionAriaLabel}>
        <div class="hero-glow hero-glow--violet" aria-hidden="true"></div>
        <div class="hero-glow hero-glow--gold" aria-hidden="true"></div>
        <div class="hero-motif" aria-hidden="true"></div>

        <div class="hero-inner">
          <div class="hero-copy">
            <div class="logo-lockup" aria-label={hero.data.logoAriaLabel}>
              <span class="wordmark">{hero.data.wordmark}</span>
            </div>

            <h1>{hero.data.headline}</h1>
            <p class="hero-sub">
              {hero.data.subheadline}
            </p>

            <div class="hero-ctas">
              <a class="btn btn--primary" href={hero.data.ctaPrimaryHref}>{hero.data.ctaPrimaryLabel}</a>
              <a class="btn btn--ghost" href={hero.data.ctaSecondaryHref}>{hero.data.ctaSecondaryLabel}</a>
            </div>
          </div>

          <div class="hero-logo-video">
            <!-- Animated brand logo, shown large on its own standalone column
                 (desktop). Decorative brand identity: aria-hidden, the static
                 PNG poster shows before the video loads and when autoplay is
                 blocked or reduced motion is preferred. -->
            <video
              autoplay
              loop
              muted
              playsinline
              aria-hidden="true"
              poster="/boucle.dev/boucle-logo.png"
            >
              <source src="/boucle.dev/boucle-logo.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
      </section>

      <!-- ============ HOW IT WORKS ============ -->
      <section class="how" id="how-it-works" aria-labelledby="how-title">
        <div class="container">
          <h2 id="how-title">{howItWorks.data.title}</h2>
          <p class="section-sub">
            {howItWorks.data.sub}
          </p>

          <ul class="how-logos" aria-label={howItWorks.data.logosAriaLabel}>
            <li>
              <img
                src={howItWorks.data.githubSrc}
                alt={howItWorks.data.githubAlt}
                class="github-logo"
                loading="lazy"
                decoding="async"
              />
            </li>
            <li>
              <img
                src={howItWorks.data.gitlabSrc}
                alt={howItWorks.data.gitlabAlt}
                loading="lazy"
                decoding="async"
              />
            </li>
          </ul>

          <div class="steps">
            <div class="steps-track" id="steps-track">
            {
              steps.map((step, i) => (
                <div class="step" role="group" aria-roledescription="slide" aria-label={howItWorks.data.slideAriaLabelTemplate.replace('{n}', String(i + 1)).replace('{total}', String(steps.length))} aria-hidden={i === 0 ? 'false' : 'true'}>
                  <div class="step-head">
                    <div class="step-icon" aria-hidden="true">
                      {(() => {
                        const icons = [
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" /><path d="M9 18h6" /><path d="M10 22h4" /></svg>,
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6h16M4 12h16M4 18h10" /></svg>,
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 10v10M7 10l3-6a2 2 0 0 1 2-1h1.5A1.5 1.5 0 0 1 15 4.5V9h4a2 2 0 0 1 2 2v1a6 6 0 0 1-1 3.3L18 20H8" /></svg>,
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z" /></svg>,
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12l5 5L20 6" /></svg>,
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v12M7 8l5-5 5 5" /><path d="M4 21h16" /></svg>,
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" /><path d="M8 16H3v5" /></svg>,
                        ];
                        return icons[i % icons.length];
                      })()}
                    </div>
                    <div class="step-body">
                      <h3>{step.data.title}</h3>
                      <p>{step.data.description}</p>
                    </div>
                  </div>
                  <div class="forge-mock" role="img" aria-label={step.data.ariaLabel}>
                    <div class="mock-bar" aria-hidden="true">
                      <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                      {step.data.url && <span class="mock-url">{step.data.url}</span>}
                    </div>
                    {step.data.blocks.length > 0 && (
                    <div class="mock-body" aria-hidden="true">
                      {
                        step.data.blocks.map((block) => {
                          switch (block.type) {
                            case 'badge':
                              return <p class={`mock-badge ${block.className ?? ''}`}>{block.text}</p>;
                            case 'title':
                              return <p class="mock-title">{block.text}</p>;
                            case 'desc':
                              return <p class="mock-desc">{block.text}</p>;
                            case 'meta':
                              return (
                                <p class="mock-meta">
                                  {block.avatarClass !== undefined && <span class={'mock-avatar' + (block.avatarClass ? ` ${block.avatarClass}` : '')}></span>}
                                  {block.text}
                                </p>
                              );
                            case 'author':
                              return (
                                <p class="mock-author">
                                  <span class={'mock-avatar' + (block.avatarClass ? ` ${block.avatarClass}` : '')}></span>
                                  {block.text}
                                </p>
                              );
                            case 'comment':
                              return <p class="mock-comment">{block.text}</p>;
                            case 'preview':
                              return (
                                <div class="mock-preview">
                                  <span class="mock-preview-line"></span>
                                  <span class="mock-preview-line mock-preview-line--short"></span>
                                  <span class="mock-preview-block"></span>
                                </div>
                              );
                            case 'reactions':
                              return (
                                <div class="mock-reactions">
                                  {block.items.map((r) => (
                                    <span class={'mock-reaction' + (r.active ? ' mock-reaction--active flow-thumb' : '')}>{r.label}</span>
                                  ))}
                                </div>
                              );
                            case 'hint':
                              return <p class="mock-hint">{block.text}</p>;
                            case 'status':
                              return (
                                <p class="mock-status">
                                  <span class="mock-spinner" aria-hidden="true"></span>
                                  <span class="mock-pulse"></span>
                                  {block.text}
                                </p>
                              );
                            case 'prTitle':
                              return <p class="mock-pr-title">{block.text}</p>;
                            case 'verdict':
                              return <div class={`mock-verdict ${block.className}`}>{block.text}</div>;
                            case 'deploy':
                              return (
                                <div class="mock-deploy" aria-hidden="true">
                                  <span class="mock-deploy-fill"></span>
                                </div>
                              );
                            case 'deployLabel':
                              return (
                                <p class="mock-deploy-label" aria-hidden="true">
                                  <svg class="mock-deploy-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                    <path d="M4 12l5 5L20 6" />
                                  </svg>
                                  {block.text}
                                </p>
                              );
                            case 'liveBadge':
                              return <p class="mock-badge mock-badge--live">{block.text}</p>;
                            default:
                              return null;
                          }
                        })
                      }
                    </div>
                    )}
                  </div>
                </div>
              ))
            }
            </div>

            <!-- Slideshow controls — prev/next arrows, dot indicator -->
            <div class="steps-controls">
              <button
                type="button"
                class="step-nav"
                id="step-prev"
                aria-label={howItWorks.data.prevStepLabel}
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M15 18l-6-6 6-6" />
                </svg>
              </button>
              <div class="step-dots" id="step-dots" role="tablist" aria-label={howItWorks.data.stepNavAriaLabel} data-dot-label-template={howItWorks.data.dotAriaLabelTemplate}></div>
              <button
                type="button"
                class="step-nav"
                id="step-next"
                aria-label={howItWorks.data.nextStepLabel}
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M9 6l6 6-6 6" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ WHY BOUCLE ============ -->
      <section class="why" id="why-boucle" aria-labelledby="why-title">
        <div class="container">
          <h2 id="why-title">{whyBoucle.data.title}</h2>
          <p class="section-sub">
            {whyBoucle.data.sub}
          </p>

          <div class="cards">
            <div class="card card--featured">
