---
// boucle.dev — landing page
// Afro-futurist + Goldilocks. Single-page static site, no raster images.
// Conforms to VISUAL-CHARTER.md (tokens, components, content directives).
// English copy (public, global audience). Self-hosted fonts (no CDN, GDPR).
const title = 'boucle — zero-code autonomous product builder';
const description =
  "Great ideas deserve to ship. From a ticket in your forge to a feature in production. Boucle works so you can live. You decide at the key moments, nothing else.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    <link rel="icon" type="image/svg+xml" href="/boucle.dev/favicon.svg" />
    <style>
      /* Self-hosted fonts — no Google Fonts CDN (GDPR).
         Unbounded (display) and Sora (body) are variable fonts (wght axis),
         so a single woff2 serves the whole weight range. Space Mono is static. */
      @font-face {
        font-family: 'Unbounded';
        font-style: normal;
        font-weight: 200 900;
        font-display: swap;
        src: url('/boucle.dev/fonts/unbounded.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Sora';
        font-style: normal;
        font-weight: 400 800;
        font-display: swap;
        src: url('/boucle.dev/fonts/sora.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Space Mono';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/boucle.dev/fonts/space-mono-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Space Mono';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/boucle.dev/fonts/space-mono-700.woff2') format('woff2');
      }

      :root {
        /* Forge surfaces — GitHub-dark-inspired (Primer Product UI), per VISUAL-CHARTER §2. */
        --surface-base: #0d1117;
        --bg-secondary: #161b22;
        --surface-raised: #21262d;
        /* Afro-futurist accents — preserved, unchanged. */
        --accent: #f5c842;
        --accent-gold-dim: #c9a233;
        --accent-violet: #7b2ff7;
        --accent-cyan: #00e5ff;
        --text-primary: #f0f0f5;
        --text-secondary: #a0a0b8;
        --text-gold: #f5c842;
        --border: rgba(245, 200, 66, 0.15);
        --border-neutral: rgba(255, 255, 255, 0.08);
        --glow-gold: rgba(245, 200, 66, 0.3);
        --glow-violet: rgba(123, 47, 247, 0.25);
        /* Forge radii & shadows (Primer/Pajamas) */
        --radius: 6px;
        --shadow-subtle: 0 1px 3px rgba(0, 0, 0, 0.3);
        --font-display: 'Unbounded', 'Sora', sans-serif;
        --font-body: system-ui, 'Sora', sans-serif;
        --font-mono: 'Space Mono', monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--surface-base);
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* Skip link for keyboard users */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: var(--accent);
        color: var(--surface-base);
        font-weight: 600;
        text-decoration: none;
        border-radius: var(--radius);
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
      }

      a {
        color: var(--accent-cyan);
      }
      a:hover {
        color: var(--accent);
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      section {
        padding: clamp(3rem, 8vw, 6rem) 1.5rem;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        margin: 0 0 1rem;
        line-height: 1.15;
      }

      h2 {
        font-size: clamp(1.8rem, 4vw, 3rem);
        font-weight: 600;
        text-align: center;
      }

      .section-sub {
        text-align: center;
        color: var(--text-secondary);
        max-width: 640px;
        margin: 0 auto 3rem;
      }

      /* ============ HERO ============ */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        background: linear-gradient(180deg, var(--surface-base), var(--bg-secondary));
        padding: 4rem 1.5rem;
      }

      .hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        animation: glow-pulse 4s ease-in-out infinite;
      }
      .hero-glow--violet {
        width: 480px;
        height: 480px;
        background: var(--glow-violet);
        top: -120px;
        left: -120px;
      }
      .hero-glow--gold {
        width: 420px;
        height: 420px;
        background: var(--glow-gold);
        bottom: -140px;
        right: -120px;
        animation-delay: 2s;
      }

      @keyframes glow-pulse {
        0%,
        100% {
          opacity: 0.5;
          transform: scale(1);
        }
        50% {
          opacity: 1;
          transform: scale(1.08);
        }
      }

      /* Subtle kente/adinkra-inspired geometric band (Sahelian motif).
         Decorative only, low opacity, aria-hidden, no motion. */
      .hero-motif {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: min(720px, 90vw);
        height: 14px;
        opacity: 0.35;
        pointer-events: none;
        background-image: repeating-linear-gradient(
          90deg,
          var(--accent) 0 6px,
          transparent 6px 12px,
          var(--accent-violet) 12px 16px,
          transparent 16px 22px,
          var(--accent-cyan) 22px 26px,
          transparent 26px 32px
        );
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
      }

      .hero-inner {
        position: relative;
        z-index: 1;
        max-width: 760px;
      }

      .logo-lockup {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 2rem;
      }
      .logo-lockup svg {
        width: 56px;
        height: 56px;
      }
      .wordmark {
        font-family: var(--font-display);
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-gold);
        letter-spacing: 0.02em;
      }

      .hero h1 {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 700;
        margin-bottom: 1.25rem;
      }

      .hero-sub {
        font-size: clamp(1.05rem, 2.2vw, 1.35rem);
        color: var(--text-secondary);
        max-width: 620px;
        margin: 0 auto 2.5rem;
      }

      /* Forge badges — "Lives in your forge" visual cue (Primer/Pajamas look:
         6px radius, subtle neutral border, raised bg, small mono-ish font). */
      .forge-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        list-style: none;
        margin: 0 auto 2.5rem;
        padding: 0;
      }
      .forge-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.85rem;
        background: var(--surface-raised);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        box-shadow: var(--shadow-subtle);
        color: var(--text-secondary);
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-decoration: none;
        transition: color 0.2s ease, border-color 0.2s ease;
      }
      .forge-badge:hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .forge-badge svg {
        width: 16px;
        height: 16px;
        display: block;
      }

      .hero-ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
      }

      .btn {
        display: inline-block;
        padding: 0.85rem 1.75rem;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.05rem;
        text-decoration: none;
        border-radius: var(--radius);
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      }
      .btn--primary {
        background: var(--accent);
        color: var(--surface-base);
      }
      .btn--primary:hover {
        background: var(--accent-gold-dim);
        color: var(--surface-base);
      }
      .btn--ghost {
        border: 1px solid var(--border);
        color: var(--text-primary);
      }
      .btn--ghost:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      /* ============ HOW IT WORKS ============ */
      .how {
        background: var(--surface-base);
      }

      .steps {
        position: relative;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        margin-top: 2rem;
      }

      /* The "boucle" — a visible gold dotted connector line.
         Vertical on mobile, horizontal on desktop. */
      .steps::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 28px;
        width: 0;
        border-left: 2px dashed var(--accent);
        opacity: 0.55;
      }

      .step {
        position: relative;
        padding-left: 0;
        max-width: 100%;
      }

      .step-head {
        display: flex;
        gap: 1.25rem;
        align-items: flex-start;
      }

      .step-icon {
        flex: 0 0 auto;
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-secondary);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        color: var(--accent);
      }
      .step-icon svg {
        width: 28px;
        height: 28px;
      }

      .step-body h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 0.35rem;
      }
      .step-body p {
        margin: 0;
        color: var(--text-secondary);
      }

      /* Forge mini-mockup — pure HTML/CSS, no external images.
         Text tokens (primary/secondary) on bg-secondary/raised keep
         WCAG 2.1 AA contrast (>= 4.5:1). Decorative internals are
         aria-hidden; the mock carries a role="img" aria-label. */
      .forge-mock {
        margin-top: 1.25rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 0;
        overflow: hidden;
        text-align: left;
        font-size: 0.8rem;
        line-height: 1.4;
      }
      .mock-bar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.75rem;
        background: var(--surface-raised);
        border-bottom: 1px solid var(--border);
      }
      .mock-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--border);
      }
      .mock-url {
        color: var(--text-secondary);
        font-size: 0.7rem;
        margin-left: 0.25rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .mock-body {
        padding: 0.85rem 0.9rem;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        color: var(--text-secondary);
      }
      .mock-title {
        margin: 0;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-desc,
      .mock-meta,
      .mock-comment,
      .mock-hint,
      .mock-pr-title {
        margin: 0;
      }
      .mock-meta {
        font-size: 0.72rem;
      }
      .mock-badge {
        display: inline-block;
        width: fit-content;
        padding: 0.15rem 0.55rem;
        margin: 0;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border-radius: 999px;
      }
      .mock-badge--issue {
        color: var(--surface-base);
        background: var(--accent);
      }
      .mock-badge--live {
        color: var(--text-primary);
        background: rgba(0, 229, 255, 0.18);
        border: 1px solid rgba(0, 229, 255, 0.4);
      }
      .mock-avatar {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 999px;
        background: var(--text-secondary);
        vertical-align: middle;
        margin-right: 0.35rem;
      }
      .mock-avatar--gold {
        background: var(--accent);
      }
      .mock-author {
        margin: 0;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-preview {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0.6rem;
        background: var(--surface-base);
        border: 1px solid var(--border);
      }
      .mock-preview-line {
        display: block;
        height: 7px;
        background: var(--border);
      }
      .mock-preview-line--short {
        width: 60%;
      }
      .mock-preview-block {
        display: block;
        height: 42px;
        background: var(--surface-raised);
        border: 1px solid var(--border);
      }
      .mock-reactions {
        display: flex;
        gap: 0.5rem;
      }
      .mock-reaction {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.55rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 0.75rem;
        color: var(--text-secondary);
      }
      .mock-reaction--active {
        border-color: var(--accent);
        color: var(--accent);
      }
      .mock-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-spinner {
        width: 12px;
        height: 12px;
        border: 2px solid var(--border);
        border-top-color: var(--accent);
        border-radius: 999px;
        animation: mock-spin 0.9s linear infinite;
      }
      @keyframes mock-spin {
        to {
          transform: rotate(360deg);
        }
      }
      .mock-pulse {
        width: 9px;
        height: 9px;
        border-radius: 999px;
        background: var(--accent);
        animation: mock-pulse 1.4s ease-in-out infinite;
      }
      @keyframes mock-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.3;
        }
      }
      .mock-verdict {
        display: inline-block;
        width: fit-content;
        padding: 0.2rem 0.7rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        border-radius: 999px;
      }
      .mock-verdict--pass {
        color: var(--surface-base);
        background: var(--accent);
      }
      .mock-verdict--merged {
        color: var(--surface-base);
        background: var(--accent);
      }

      /* ============ VALIDATION FLOW ANIMATIONS ============ */
      /* Subtle gestures that bring the validation cycle to life.
         CSS-only, sequenced: thumb-up → verdict → deploy.
         The ambient loop pulse runs continuously in the hero. */
      .flow-thumb {
        animation: flow-fade-in-up 0.6s ease-out 0.3s both;
      }
      .flow-verdict {
        animation: flow-fade-in 0.6s ease-out 1s both;
      }
      .mock-deploy {
        display: block;
        height: 6px;
        margin: 0.6rem 0;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface-raised);
      }
      .mock-deploy-fill {
        display: block;
        height: 100%;
        transform-origin: left;
        transform: scaleX(0);
        background: var(--accent);
        border-radius: 999px;
        animation: deploy-fill 0.6s ease-out 1.7s both;
      }
      .mock-deploy-label {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.5rem;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-deploy-check {
        width: 11px;
        height: 11px;
        flex: none;
        color: var(--accent);
        animation: flow-fade-in 0.5s ease-out 2.1s both;
      }
      .loop-pulse {
        animation: loop-pulse 3s ease-in-out infinite;
      }
      @keyframes flow-fade-in-up {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes flow-fade-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      @keyframes deploy-fill {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }
      @keyframes loop-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.45;
        }
      }

      /* ============ LIVES IN YOUR FORGE ============ */
      .forge {
        background: var(--surface-base);
      }
      .forge-message {
        text-align: center;
        color: var(--text-primary);
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
        font-weight: 600;
        max-width: 640px;
        margin: 0 auto 3rem;
      }
      .forge-logos {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .forge-logos a {
        display: inline-flex;
        align-items: center;
        color: var(--text-primary);
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .forge-logos a:hover {
        color: var(--accent);
      }
      .forge-logos svg {
        width: clamp(120px, 20vw, 180px);
        height: auto;
        display: block;
      }

      /* ============ WHY BOUCLE ============ */
      .why {
        background: var(--bg-secondary);
      }

      .cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .card {
        background: var(--surface-base);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        box-shadow: var(--shadow-subtle);
        padding: 1.75rem;
      }
      .card h3 {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 0.75rem;
      }
      .card .pain {
        color: var(--text-secondary);
        margin: 0 0 0.5rem;
      }
      .card .answer {
        color: var(--text-primary);
        margin: 0;
      }
      .card .arrow {
        color: var(--accent-violet);
        margin: 0 0 0.5rem;
        font-family: var(--font-mono);
      }

      /* Featured promise — "Lives in your forge", the key differentiator.
         Spans the full card grid width and gets a distinct gold treatment. */
      .card--featured {
        grid-column: 1 / -1;
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent), 0 0 24px var(--glow-gold);
        padding: 2.25rem;
      }
      .card--featured h3 {
        font-size: 1.5rem;
      }

      .why-positioning {
        margin: 2.5rem auto 0;
        max-width: 640px;
        text-align: center;
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
        font-weight: 600;
        color: var(--text-gold);
      }

      /* ============ QUICK START ============ */
      .quick {
        background: var(--surface-base);
      }

      .quick-install {
        max-width: 720px;
        margin: 0 auto;
      }
      .quick-install .label {
        font-family: var(--font-mono);
        color: var(--accent);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }
      .code {
        background: var(--surface-raised);
        border-radius: var(--radius);
        padding: 0.9rem 1rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--accent-cyan);
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-word;
        margin: 0;
      }

      /* The install→usage transition: a visually distinct panel that marks
         the shift from "setup tooling" to "daily usage in your own forge".
         Gold border + raised background per charter §2 tokens. */
      .quick-transition {
        max-width: 720px;
        margin: 1.5rem auto 0;
        background: var(--bg-secondary);
        border: 1px solid var(--accent);
        border-radius: var(--radius);
        padding: 1.5rem;
        box-shadow: 0 0 24px var(--glow-gold);
      }
      .quick-transition .num {
        font-family: var(--font-mono);
        color: var(--accent);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }
      .quick-transition p {
        margin: 0;
        color: var(--text-primary);
      }
      .quick-transition code {
        font-family: var(--font-mono);
        color: var(--accent);
        background: var(--surface-raised);
        padding: 0.1rem 0.35rem;
        border-radius: var(--radius);
      }

      .quick-link {
        display: inline-block;
        margin-top: 2rem;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
      }
      .quick-link:hover {
        color: var(--accent-gold-dim);
      }

      /* ============ FOOTER ============ */
      footer {
        background: var(--surface-base);
        border-top: 1px solid var(--border);
        padding: 2.5rem 1.5rem;
        text-align: center;
      }
      .footer-made {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin: 0 0 1rem;
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        justify-content: center;
        font-size: 0.9rem;
      }
      .footer-links a {
        color: var(--text-secondary);
        text-decoration: none;
      }
      .footer-links a:hover {
        color: var(--accent);
      }

      /* ============ RESPONSIVE ============ */
      @media (min-width: 768px) {
        .cards {
          grid-template-columns: repeat(2, 1fr);
        }
        .forge-logos {
          flex-direction: row;
          justify-content: center;
          gap: 3rem;
        }
        .steps {
          grid-template-columns: repeat(2, 1fr);
          gap: 2.5rem 2rem;
        }
        /* Two-column layout: dotted connector runs vertically down each column. */
        .steps::before {
          left: 28px;
        }
      }
      @media (min-width: 1024px) {
        .steps {
          grid-template-columns: repeat(3, 1fr);
          gap: 3rem 1.5rem;
        }
        /* Horizontal dotted connector across the 3-column grid (two rows). */
        .steps::before {
          top: 28px;
          bottom: auto;
          left: 0;
          right: 0;
          width: auto;
          height: 0;
          border-left: none;
          border-top: 2px dashed var(--accent);
        }
        .step {
          flex-direction: column;
          align-items: center;
          text-align: center;
          padding: 0;
        }
        .step-head {
          flex-direction: column;
          align-items: center;
        }
        .step-body p {
          max-width: 260px;
          margin: 0 auto;
        }
        .cards {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      /* ============ REDUCED MOTION ============ */
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .hero-glow {
          animation: none;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main">
      <!-- ============ HERO ============ -->
      <section class="hero" aria-label="boucle — introduction">
        <div class="hero-glow hero-glow--violet" aria-hidden="true"></div>
        <div class="hero-glow hero-glow--gold" aria-hidden="true"></div>
        <div class="hero-motif" aria-hidden="true"></div>

        <div class="hero-inner">
          <div class="logo-lockup">
            <!-- Figurative afro-futurist logo: a face with a golden afro
                 (full circle = the "boucle"), gold hoop créoles, an
                 afrofuturist gold visor with the infinity loop (∞) woven
                 into the bridge. Inline SVG, no raster. -->
            <svg
              viewBox="0 0 100 100"
              role="img"
              aria-label="boucle logo — afrofuturist face with golden afro, créoles, and sunglasses"
              fill="none"
            >
              <!-- Afro: full gold circle (the "boucle") -->
              <circle cx="50" cy="50" r="46" fill="var(--accent, #f5c842)" />
              <!-- Face: figurative silhouette -->
              <path
                d="M50 30
                   C 40 30, 34 36, 34 44
                   L 34 60
                   C 34 70, 40 78, 50 78
                   C 60 78, 66 70, 66 60
                   L 66 44
                   C 66 36, 60 30, 50 30
                   Z"
                fill="var(--surface-base, #0d1117)"
              />
              <!-- Sunglasses: afrofuturist gold visor -->
              <rect x="36" y="44" width="28" height="10" rx="5" fill="var(--accent, #f5c842)" />
              <!-- Infinity loop (∞) woven into the visor bridge -->
              <circle class="loop-pulse" cx="46" cy="49" r="3.5" fill="var(--surface-base, #0d1117)" />
              <circle class="loop-pulse" cx="54" cy="49" r="3.5" fill="var(--surface-base, #0d1117)" />
              <!-- Créoles: gold hoop earrings (dark rings = hoop openings) -->
              <circle cx="30" cy="62" r="5" stroke="var(--surface-base, #0d1117)" stroke-width="2.5" />
              <circle cx="70" cy="62" r="5" stroke="var(--surface-base, #0d1117)" stroke-width="2.5" />
            </svg>
            <span class="wordmark">boucle</span>
          </div>

          <h1>Great ideas deserve to ship.</h1>
          <p class="hero-sub">
            From a ticket in your forge to a feature in production. Boucle
            works so you can live. You decide at the key moments, nothing else. 👍👎
          </p>

          <ul class="forge-badges" aria-label="Forge badges">
            <li>
              <a class="forge-badge" href="https://github.com">
                <svg viewBox="0 0 24 24" role="img" aria-label="GitHub" fill="currentColor">
                  <path
                    d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.13-.3-.54-1.53.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3.01-.41c1.02 0 2.05.14 3.01.41 2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.88.12 3.18.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22 0 1.61-.02 2.9-.02 3.3 0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
                  />
                </svg>
                GitHub
              </a>
            </li>
            <li>
              <a class="forge-badge" href="https://gitlab.com">
                <svg viewBox="0 0 24 24" role="img" aria-label="GitLab" fill="currentColor">
                  <path
                    d="m23.6004 9.5927-.0337-.0862L20.3.9814a.851.851 0 0 0-.3362-.405.8748.8748 0 0 0-.9997.0539.8748.8748 0 0 0-.29.4399l-2.2055 6.748H7.5375l-2.2057-6.748a.8573.8573 0 0 0-.29-.4412.8748.8748 0 0 0-.9997-.0537.8585.8585 0 0 0-.3362.4049L.4332 9.5015l-.0325.0862a6.0657 6.0657 0 0 0 2.0119 7.0105l.0113.0087.03.0213 4.976 3.7264 2.462 1.8633a1.0287 1.0287 0 0 0 1.2197 0l2.462-1.8633 4.976-3.7264.0305-.0213.0113-.0087a6.0657 6.0657 0 0 0 2.0114-7.0086z"
                  />
                </svg>
                GitLab
              </a>
            </li>
          </ul>

          <div class="hero-ctas">
            <a class="btn btn--primary" href="#quick-start">Get started</a>
            <a class="btn btn--ghost" href="#how-it-works">How it works</a>
          </div>
        </div>
      </section>

      <!-- ============ HOW IT WORKS ============ -->
      <section class="how" id="how-it-works" aria-labelledby="how-title">
        <div class="container">
          <h2 id="how-title">How it works</h2>
          <p class="section-sub">
            Six steps, one loop. You stay in your forge, boucle does the rest.
          </p>

          <div class="steps">
            <!-- 1. Drop the idea in an issue -->
            <div class="step">
              <div class="step-head">
                <div class="step-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 3" />
                  </svg>
                </div>
                <div class="step-body">
                  <h3>Je droppe mon idée dans une issue</h3>
                  <p>Je crée une issue dans ma forge, avec un titre et une description. C'est juste un ticket normal.</p>
                </div>
              </div>
              <div class="forge-mock" role="img" aria-label="Mockup de la forge : une issue ouverte avec un titre et une description en attente.">
                <div class="mock-bar" aria-hidden="true">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                  <span class="mock-url">github.com/mon-repo/issues</span>
                </div>
                <div class="mock-body" aria-hidden="true">
                  <p class="mock-badge mock-badge--issue">Issue</p>
                  <p class="mock-title">Ajouter un mode sombre</p>
                  <p class="mock-desc">Quand je passe le site en sombre, les couleurs ne collent pas au thème.</p>
                  <p class="mock-meta"><span class="mock-avatar"></span> moi · ouvert</p>
                </div>
              </div>
            </div>

            <!-- 2. A proposal with an image -->
            <div class="step">
              <div class="step-head">
                <div class="step-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 6h16M4 12h16M4 18h10" />
                  </svg>
                </div>
                <div class="step-body">
                  <h3>Je reçois une proposition avec une image</h3>
                  <p>boucle analyse, écrit un spec et poste un commentaire sur l'issue avec un aperçu. Je vois exactement ce que ça va donner.</p>
                </div>
              </div>
              <div class="forge-mock" role="img" aria-label="Mockup de la forge : un commentaire de boucle avec un spec et un aperçu de la page proposée.">
                <div class="mock-bar" aria-hidden="true">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                  <span class="mock-url">github.com/mon-repo/issues/12</span>
                </div>
                <div class="mock-body" aria-hidden="true">
                  <p class="mock-author"><span class="mock-avatar mock-avatar--gold"></span> boucle-bot</p>
                  <p class="mock-comment">Voici le spec et un aperçu de ce que ça donnera.</p>
                  <div class="mock-preview">
                    <span class="mock-preview-line"></span>
                    <span class="mock-preview-line mock-preview-line--short"></span>
                    <span class="mock-preview-block"></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- 3. Validate with a thumb -->
            <div class="step">
              <div class="step-head">
                <div class="step-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M7 10v10M7 10l3-6a2 2 0 0 1 2-1h1.5A1.5 1.5 0 0 1 15 4.5V9h4a2 2 0 0 1 2 2v1a6 6 0 0 1-1 3.3L18 20H8" />
                  </svg>
                </div>
                <div class="step-body">
                  <h3>Je valide avec un pouce</h3>
                  <p>Je réagis avec un pouce vers le haut sur le commentaire de spec. Pas de formulaire, pas de CLI. Juste un emoji.</p>
                </div>
              </div>
              <div class="forge-mock" role="img" aria-label="Mockup de la forge : la réaction pouce vers le haut activée sur le commentaire de spec.">
                <div class="mock-bar" aria-hidden="true">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                  <span class="mock-url">github.com/mon-repo/issues/12</span>
                </div>
                <div class="mock-body" aria-hidden="true">
                  <div class="mock-reactions">
                    <span class="mock-reaction mock-reaction--active flow-thumb">👍 1</span>
                    <span class="mock-reaction">👀 1</span>
                  </div>
                  <p class="mock-hint">Réaction ajoutée : boucle démarre.</p>
                </div>
              </div>
            </div>

            <!-- 4. It works -->
            <div class="step">
              <div class="step-head">
                <div class="step-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1" />
                  </svg>
                </div>
                <div class="step-body">
                  <h3>Ça bosse</h3>
                  <p>boucle implémente, build, déploie un aperçu. Je n'ai rien à faire pendant ce temps. L'agent travaille.</p>
                </div>
              </div>
              <div class="forge-mock" role="img" aria-label="Mockup de la forge : le statut de travail actif de l'agent boucle avec une animation.">
                <div class="mock-bar" aria-hidden="true">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                  <span class="mock-url">github.com/mon-repo/actions</span>
                </div>
                <div class="mock-body" aria-hidden="true">
                  <p class="mock-status">
                    <span class="mock-spinner" aria-hidden="true"></span>
                    <span class="mock-pulse"></span>
                    En cours — l'agent travaille
                  </p>
                  <p class="mock-meta">build · preview · vérification</p>
                </div>
              </div>
            </div>

            <!-- 5. It is verified -->
            <div class="step">
              <div class="step-head">
                <div class="step-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 12l5 5L20 6" />
                  </svg>
                </div>
                <div class="step-body">
                  <h3>C'est vérifié</h3>
                  <p>Le reviewer vérifie le rendu, poste un verdict (PASS/FAIL) en commentaire sur la PR. Si FAIL, ça boucle. Si PASS, la PR est prête.</p>
                </div>
              </div>
              <div class="forge-mock" role="img" aria-label="Mockup de la forge : une pull request avec un verdict PASS en commentaire.">
                <div class="mock-bar" aria-hidden="true">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                  <span class="mock-url">github.com/mon-repo/pull/25</span>
                </div>
                <div class="mock-body" aria-hidden="true">
                  <p class="mock-pr-title">Pull request — mode sombre</p>
                  <div class="mock-verdict mock-verdict--pass flow-verdict">PASS</div>
                  <p class="mock-comment">Vérifié : le rendu correspond au spec. Prêt à fusionner.</p>
                </div>
              </div>
            </div>

            <!-- 6. Validate, it is live -->
            <div class="step">
              <div class="step-head">
                <div class="step-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 3v12M7 8l5-5 5 5" />
                    <path d="M4 21h16" />
                  </svg>
                </div>
                <div class="step-body">
                  <h3>Je valide, c'est live</h3>
                  <p>J'approuve la PR (ou boucle merge selon la config). La feature ship en production. C'est live.</p>
                </div>
              </div>
              <div class="forge-mock" role="img" aria-label="Mockup de la forge : une pull request fusionnée avec un badge live.">
                <div class="mock-bar" aria-hidden="true">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                  <span class="mock-url">github.com/mon-repo/pull/25</span>
                </div>
                <div class="mock-body" aria-hidden="true">
                  <p class="mock-pr-title">Pull request — mode sombre</p>
                  <div class="mock-deploy" aria-hidden="true">
                    <span class="mock-deploy-fill"></span>
                  </div>
                  <p class="mock-deploy-label" aria-hidden="true">
                    <svg class="mock-deploy-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <path d="M4 12l5 5L20 6" />
                    </svg>
                    Feature déployée
                  </p>
                  <div class="mock-verdict mock-verdict--merged">MERGED</div>
                  <p class="mock-badge mock-badge--live">● Live en production</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ LIVES IN YOUR FORGE ============ -->
      <section class="forge" id="lives-in-your-forge" aria-labelledby="forge-title">
        <div class="container">
          <h2 id="forge-title">Lives in your forge</h2>
          <p class="forge-message">
            boucle lives in your forge. GitHub, GitLab. No external tool, no dashboard.
          </p>

          <ul class="forge-logos">
            <li>
              <a href="https://github.com">
                <!-- GitHub mark — official octocat silhouette, single-color (white on dark). -->
                <svg viewBox="0 0 24 24" role="img" aria-label="GitHub logo" fill="currentColor">
                  <path
                    d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.13-.3-.54-1.53.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3.01-.41c1.02 0 2.05.14 3.01.41 2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.88.12 3.18.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22 0 1.61-.02 2.9-.02 3.3 0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
                  />
                </svg>
              </a>
            </li>
            <li>
              <a href="https://gitlab.com">
                <!-- GitLab tanuki — official logo, single-color (white on dark). -->
                <svg viewBox="0 0 24 24" role="img" aria-label="GitLab logo" fill="currentColor">
                  <path
                    d="m23.6004 9.5927-.0337-.0862L20.3.9814a.851.851 0 0 0-.3362-.405.8748.8748 0 0 0-.9997.0539.8748.8748 0 0 0-.29.4399l-2.2055 6.748H7.5375l-2.2057-6.748a.8573.8573 0 0 0-.29-.4412.8748.8748 0 0 0-.9997-.0537.8585.8585 0 0 0-.3362.4049L.4332 9.5015l-.0325.0862a6.0657 6.0657 0 0 0 2.0119 7.0105l.0113.0087.03.0213 4.976 3.7264 2.462 1.8633a1.0287 1.0287 0 0 0 1.2197 0l2.462-1.8633 4.976-3.7264.0305-.0213.0113-.0087a6.0657 6.0657 0 0 0 2.0114-7.0086z"
                  />
                </svg>
              </a>
            </li>
          </ul>
        </div>
      </section>

      <!-- ============ WHY BOUCLE ============ -->
      <section class="why" id="why-boucle" aria-labelledby="why-title">
        <div class="container">
          <h2 id="why-title">Why boucle</h2>
          <p class="section-sub">
            Powerful but simple. Five promises, one loop.
          </p>

          <div class="cards">
            <div class="card card--featured">
              <h3>Lives in your forge</h3>
              <p class="pain">A new tool to learn, a dashboard to babysit.</p>
              <p class="arrow">→</p>
              <p class="answer">boucle lives in your forge (GitHub/GitLab). No external tool, no separate dashboard. Everything happens where you already work.</p>
              <p class="answer"><a href="#lives-in-your-forge">See where boucle lives →</a></p>
            </div>

            <div class="card">
              <h3>Deterministic and reliable</h3>
              <p class="pain">An agent that decides everything, with no human review.</p>
              <p class="arrow">→</p>
              <p class="answer">Deterministic, therefore reliable. You intervene at the right moment, at the decision points.</p>
            </div>

            <div class="card">
              <h3>Works while you sleep</h3>
              <p class="pain">A daemon to babysit, a laptop left on all night.</p>
              <p class="arrow">→</p>
              <p class="answer">The agent works overnight for you. You intervene only when it matters.</p>
            </div>

            <div class="card">
              <h3>No UI, No CLI</h3>
              <p class="pain">A new interface to learn, a command line to master.</p>
              <p class="arrow">→</p>
              <p class="answer">No interface to learn, no command line to master. You interact through your forge: issues, comments, labels.</p>
            </div>

            <div class="card">
              <h3>Self-healing, self-learning loop</h3>
              <p class="pain">A static tool that never improves.</p>
              <p class="arrow">→</p>
              <p class="answer">A loop that learns from its mistakes, self-updates, and adapts to your codebase as your project advances.</p>
            </div>
          </div>

          <p class="why-positioning">
            Harness made for human, made by an indie product builder for product builders.
          </p>
        </div>
      </section>

      <!-- ============ QUICK START ============ -->
      <section class="quick" id="quick-start" aria-labelledby="quick-title">
        <div class="container">
          <h2 id="quick-title">Quick start</h2>
          <p class="section-sub">
            One command, and the loop takes over.
          </p>

          <div class="quick-install">
            <div class="label">Install</div>
            <pre class="code"><code>curl -fsSL https://ankaboot-source.github.io/boucle.dev/install.sh | bash</code></pre>
          </div>

          <div class="quick-transition">
            <div class="num">Next</div>
            <p>Create an issue in your forge and tag it <code>boucle:triage</code> — the loop starts.</p>
          </div>

          <a class="quick-link" href="https://github.com/ankaboot-source/boucle/blob/main/README.md">
            View the docs →
          </a>
        </div>
      </section>
    </main>

