---
// boucle.dev — landing page
// Afro-futurist + Goldilocks. Single-page static site, no raster images.
// Conforms to VISUAL-CHARTER.md (tokens, components, content directives).
// English copy (public, global audience). Self-hosted fonts (no CDN, GDPR).
const title = 'boucle — zero-code autonomous product builder';
const description =
  "Great ideas deserve to ship. From a ticket in your forge to a feature in production. Boucle works so you can live. You decide at the key moments, nothing else.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    <link rel="icon" type="image/svg+xml" href="/boucle.dev/favicon.svg" />
    <style>
      /* Self-hosted fonts — no Google Fonts CDN (GDPR).
         Unbounded (display) and Sora (body) are variable fonts (wght axis),
         so a single woff2 serves the whole weight range. Space Mono is static. */
      @font-face {
        font-family: 'Unbounded';
        font-style: normal;
        font-weight: 200 900;
        font-display: swap;
        src: url('/boucle.dev/fonts/unbounded.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Sora';
        font-style: normal;
        font-weight: 400 800;
        font-display: swap;
        src: url('/boucle.dev/fonts/sora.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Space Mono';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/boucle.dev/fonts/space-mono-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Space Mono';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/boucle.dev/fonts/space-mono-700.woff2') format('woff2');
      }

      :root {
        /* Forge surfaces — GitHub-dark-inspired (Primer Product UI), per VISUAL-CHARTER §2. */
        --surface-base: #0d1117;
        --bg-secondary: #161b22;
        --surface-raised: #21262d;
        /* Afro-futurist accents — preserved, unchanged. */
        --accent: #f5c842;
        --accent-gold-dim: #c9a233;
        --accent-violet: #7b2ff7;
        --accent-cyan: #00e5ff;
        --text-primary: #f0f0f5;
        --text-secondary: #a0a0b8;
        --text-gold: #f5c842;
        --border: rgba(245, 200, 66, 0.15);
        --border-neutral: rgba(255, 255, 255, 0.08);
        --glow-gold: rgba(245, 200, 66, 0.3);
        --glow-violet: rgba(123, 47, 247, 0.25);
        /* Forge radii & shadows (Primer/Pajamas) */
        --radius: 6px;
        --shadow-subtle: 0 1px 3px rgba(0, 0, 0, 0.3);
        --font-display: 'Unbounded', 'Sora', sans-serif;
        --font-body: system-ui, 'Sora', sans-serif;
        --font-mono: 'Space Mono', monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--surface-base);
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* Skip link for keyboard users */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: var(--accent);
        color: var(--surface-base);
        font-weight: 600;
        text-decoration: none;
        border-radius: var(--radius);
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
      }

      a {
        color: var(--accent-cyan);
      }
      a:hover {
        color: var(--accent);
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      section {
        padding: clamp(3rem, 8vw, 6rem) 1.5rem;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        margin: 0 0 1rem;
        line-height: 1.15;
      }

      h2 {
        font-size: clamp(1.8rem, 4vw, 3rem);
        font-weight: 600;
        text-align: center;
      }

      .section-sub {
        text-align: center;
        color: var(--text-secondary);
        max-width: 640px;
        margin: 0 auto 3rem;
      }

      /* ============ HERO ============ */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        background: linear-gradient(180deg, var(--surface-base), var(--bg-secondary));
        padding: 4rem 1.5rem;
      }

      .hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        animation: glow-pulse 4s ease-in-out infinite;
      }
      .hero-glow--violet {
        width: 480px;
        height: 480px;
        background: var(--glow-violet);
        top: -120px;
        left: -120px;
      }
      .hero-glow--gold {
        width: 420px;
        height: 420px;
        background: var(--glow-gold);
        bottom: -140px;
        right: -120px;
        animation-delay: 2s;
      }

      @keyframes glow-pulse {
        0%,
        100% {
          opacity: 0.5;
          transform: scale(1);
        }
        50% {
          opacity: 1;
          transform: scale(1.08);
        }
      }

      /* Subtle kente/adinkra-inspired geometric band (Sahelian motif).
         Decorative only, low opacity, aria-hidden, no motion. */
      .hero-motif {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: min(720px, 90vw);
        height: 14px;
        opacity: 0.35;
        pointer-events: none;
        background-image: repeating-linear-gradient(
          90deg,
          var(--accent) 0 6px,
          transparent 6px 12px,
          var(--accent-violet) 12px 16px,
          transparent 16px 22px,
          var(--accent-cyan) 22px 26px,
          transparent 26px 32px
        );
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
      }

      .hero-inner {
        position: relative;
        z-index: 1;
        max-width: 760px;
      }

      .logo-lockup {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 2rem;
      }
      .logo-lockup svg {
        width: 56px;
        height: 56px;
      }
      .wordmark {
        font-family: var(--font-display);
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-gold);
        letter-spacing: 0.02em;
      }

      .hero h1 {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 700;
        margin-bottom: 1.25rem;
      }

      .hero-sub {
        font-size: clamp(1.05rem, 2.2vw, 1.35rem);
        color: var(--text-secondary);
        max-width: 620px;
        margin: 0 auto 2.5rem;
      }

      /* Forge badges — "Lives in your forge" visual cue (Primer/Pajamas look:
         6px radius, subtle neutral border, raised bg, small mono-ish font). */
      .forge-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        list-style: none;
        margin: 0 auto 2.5rem;
        padding: 0;
      }
      .forge-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.85rem;
        background: var(--surface-raised);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        box-shadow: var(--shadow-subtle);
        color: var(--text-secondary);
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-decoration: none;
        transition: color 0.2s ease, border-color 0.2s ease;
      }
      .forge-badge:hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .forge-badge svg {
        width: 16px;
        height: 16px;
        display: block;
      }

      .hero-ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
      }

      .btn {
        display: inline-block;
        padding: 0.85rem 1.75rem;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.05rem;
        text-decoration: none;
        border-radius: var(--radius);
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      }
      .btn--primary {
        background: var(--accent);
        color: var(--surface-base);
      }
      .btn--primary:hover {
        background: var(--accent-gold-dim);
        color: var(--surface-base);
      }
      .btn--ghost {
        border: 1px solid var(--border);
        color: var(--text-primary);
      }
      .btn--ghost:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      /* ============ HOW IT WORKS ============ */
      .how {
        background: var(--surface-base);
      }

      .steps {
        position: relative;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        margin-top: 2rem;
      }

      /* The "boucle" — a visible gold dotted connector line.
         Vertical on mobile, horizontal on desktop. */
      .steps::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 28px;
        width: 0;
        border-left: 2px dashed var(--accent);
        opacity: 0.55;
      }

      .step {
        position: relative;
        padding-left: 0;
        max-width: 100%;
      }

      .step-head {
        display: flex;
        gap: 1.25rem;
        align-items: flex-start;
      }

      .step-icon {
        flex: 0 0 auto;
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-secondary);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        color: var(--accent);
      }
      .step-icon svg {
        width: 28px;
        height: 28px;
      }

      .step-body h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 0.35rem;
      }
      .step-body p {
        margin: 0;
        color: var(--text-secondary);
      }

      /* Forge mini-mockup — pure HTML/CSS, no external images.
         Text tokens (primary/secondary) on bg-secondary/raised keep
         WCAG 2.1 AA contrast (>= 4.5:1). Decorative internals are
         aria-hidden; the mock carries a role="img" aria-label. */
      .forge-mock {
        margin-top: 1.25rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 0;
        overflow: hidden;
        text-align: left;
        font-size: 0.8rem;
        line-height: 1.4;
      }
      .mock-bar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.75rem;
        background: var(--surface-raised);
        border-bottom: 1px solid var(--border);
      }
      .mock-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--border);
      }
      .mock-url {
        color: var(--text-secondary);
        font-size: 0.7rem;
        margin-left: 0.25rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .mock-body {
        padding: 0.85rem 0.9rem;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        color: var(--text-secondary);
      }
      .mock-title {
        margin: 0;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-desc,
      .mock-meta,
      .mock-comment,
      .mock-hint,
      .mock-pr-title {
        margin: 0;
      }
      .mock-meta {
        font-size: 0.72rem;
      }
      .mock-badge {
        display: inline-block;
        width: fit-content;
        padding: 0.15rem 0.55rem;
        margin: 0;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border-radius: 999px;
      }
      .mock-badge--issue {
        color: var(--surface-base);
        background: var(--accent);
      }
      .mock-badge--live {
        color: var(--text-primary);
        background: rgba(0, 229, 255, 0.18);
        border: 1px solid rgba(0, 229, 255, 0.4);
      }
      .mock-avatar {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 999px;
        background: var(--text-secondary);
        vertical-align: middle;
        margin-right: 0.35rem;
      }
      .mock-avatar--gold {
        background: var(--accent);
      }
      .mock-author {
        margin: 0;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-preview {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0.6rem;
        background: var(--surface-base);
        border: 1px solid var(--border);
      }
      .mock-preview-line {
        display: block;
        height: 7px;
        background: var(--border);
      }
      .mock-preview-line--short {
        width: 60%;
      }
      .mock-preview-block {
        display: block;
        height: 42px;
        background: var(--surface-raised);
        border: 1px solid var(--border);
      }
      .mock-reactions {
        display: flex;
        gap: 0.5rem;
      }
      .mock-reaction {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.55rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 0.75rem;
        color: var(--text-secondary);
      }
      .mock-reaction--active {
        border-color: var(--accent);
        color: var(--accent);
      }
      .mock-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-spinner {
        width: 12px;
        height: 12px;
        border: 2px solid var(--border);
        border-top-color: var(--accent);
        border-radius: 999px;
        animation: mock-spin 0.9s linear infinite;
      }
      @keyframes mock-spin {
        to {
          transform: rotate(360deg);
        }
      }
      .mock-pulse {
        width: 9px;
        height: 9px;
        border-radius: 999px;
        background: var(--accent);
        animation: mock-pulse 1.4s ease-in-out infinite;
      }
      @keyframes mock-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.3;
        }
      }
      .mock-verdict {
        display: inline-block;
        width: fit-content;
        padding: 0.2rem 0.7rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        border-radius: 999px;
      }
      .mock-verdict--pass {
        color: var(--surface-base);
        background: var(--accent);
      }
      .mock-verdict--merged {
        color: var(--surface-base);
        background: var(--accent);
      }

      /* ============ VALIDATION FLOW ANIMATIONS ============ */
      /* Subtle gestures that bring the validation cycle to life.
         CSS-only, sequenced: thumb-up → verdict → deploy.
         The ambient loop pulse runs continuously in the hero. */
      .flow-thumb {
        animation: flow-fade-in-up 0.6s ease-out 0.3s both;
      }
      .flow-verdict {
        animation: flow-fade-in 0.6s ease-out 1s both;
      }
      .mock-deploy {
        display: block;
        height: 6px;
        margin: 0.6rem 0;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface-raised);
      }
      .mock-deploy-fill {
        display: block;
        height: 100%;
        transform-origin: left;
        transform: scaleX(0);
        background: var(--accent);
        border-radius: 999px;
        animation: deploy-fill 0.6s ease-out 1.7s both;
      }
      .mock-deploy-label {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.5rem;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-primary);
      }
      .mock-deploy-check {
        width: 11px;
        height: 11px;
        flex: none;
        color: var(--accent);
        animation: flow-fade-in 0.5s ease-out 2.1s both;
      }
      .loop-pulse {
        animation: loop-pulse 3s ease-in-out infinite;
      }
      @keyframes flow-fade-in-up {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes flow-fade-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      @keyframes deploy-fill {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }
      @keyframes loop-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.45;
        }
      }

      /* ============ LIVES IN YOUR FORGE ============ */
      .forge {
        background: var(--surface-base);
      }
      .forge-message {
        text-align: center;
        color: var(--text-primary);
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
        font-weight: 600;
        max-width: 640px;
        margin: 0 auto 3rem;
      }
      .forge-logos {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .forge-logos a {
        display: inline-flex;
        align-items: center;
        color: var(--text-primary);
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .forge-logos a:hover {
        color: var(--accent);
      }
      .forge-logos svg {
        width: clamp(120px, 20vw, 180px);
        height: auto;
        display: block;
      }

      /* ============ WHY BOUCLE ============ */
      .why {
        background: var(--bg-secondary);
      }

      .cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .card {
        background: var(--surface-base);
        border: 1px solid var(--border-neutral);
        border-radius: var(--radius);
        box-shadow: var(--shadow-subtle);
        padding: 1.75rem;
      }
      .card h3 {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 0.75rem;
      }
      .card .pain {
        color: var(--text-secondary);
        margin: 0 0 0.5rem;
      }
      .card .answer {
        color: var(--text-primary);
        margin: 0;
      }
      .card .arrow {
        color: var(--accent-violet);
        margin: 0 0 0.5rem;
        font-family: var(--font-mono);
      }

      /* Featured promise — "Lives in your forge", the key differentiator.
         Spans the full card grid width and gets a distinct gold treatment. */
      .card--featured {
        grid-column: 1 / -1;
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent), 0 0 24px var(--glow-gold);
        padding: 2.25rem;
      }
      .card--featured h3 {
        font-size: 1.5rem;
      }

      .why-positioning {
        margin: 2.5rem auto 0;
        max-width: 640px;
        text-align: center;
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
        font-weight: 600;
        color: var(--text-gold);
      }

      /* ============ QUICK START ============ */
      .quick {
        background: var(--surface-base);
      }

      .quick-install {
        max-width: 720px;
        margin: 0 auto;
      }
      .quick-install .label {
        font-family: var(--font-mono);
        color: var(--accent);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }
      .code {
        background: var(--surface-raised);
        border-radius: var(--radius);
        padding: 0.9rem 1rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--accent-cyan);
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-word;
        margin: 0;
      }

      /* The install→usage transition: a visually distinct panel that marks
         the shift from "setup tooling" to "daily usage in your own forge".
         Gold border + raised background per charter §2 tokens. */
      .quick-transition {
        max-width: 720px;
        margin: 1.5rem auto 0;
        background: var(--bg-secondary);
        border: 1px solid var(--accent);
        border-radius: var(--radius);
        padding: 1.5rem;
        box-shadow: 0 0 24px var(--glow-gold);
      }
      .quick-transition .num {
        font-family: var(--font-mono);
        color: var(--accent);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }
      .quick-transition p {
        margin: 0;
        color: var(--text-primary);
      }
      .quick-transition code {
        font-family: var(--font-mono);
        color: var(--accent);
        background: var(--surface-raised);
        padding: 0.1rem 0.35rem;
        border-radius: var(--radius);
      }

      .quick-link {
        display: inline-block;
        margin-top: 2rem;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
      }
      .quick-link:hover {
        color: var(--accent-gold-dim);
      }

      /* ============ FOOTER ============ */
      footer {
        background: var(--surface-base);
        border-top: 1px solid var(--border);
        padding: 2.5rem 1.5rem;
        text-align: center;
      }
      .footer-made {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin: 0 0 1rem;
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        justify-content: center;
        font-size: 0.9rem;
      }
      .footer-links a {
        color: var(--text-secondary);
        text-decoration: none;
      }
      .footer-links a:hover {
        color: var(--accent);
      }

      /* ============ RESPONSIVE ============ */
      @media (min-width: 768px) {
        .cards {
          grid-template-columns: repeat(2, 1fr);
        }
        .forge-logos {
          flex-direction: row;
          justify-content: center;
          gap: 3rem;
        }
        .steps {
          grid-template-columns: repeat(2, 1fr);
          gap: 2.5rem 2rem;
        }
        /* Two-column layout: dotted connector runs vertically down each column. */
        .steps::before {
          left: 28px;
        }
      }
      @media (min-width: 1024px) {
        .steps {
          grid-template-columns: repeat(3, 1fr);
          gap: 3rem 1.5rem;
        }
        /* Horizontal dotted connector across the 3-column grid (two rows). */
        .steps::before {
          top: 28px;
          bottom: auto;
          left: 0;
          right: 0;
          width: auto;
          height: 0;
          border-left: none;
          border-top: 2px dashed var(--accent);
        }
        .step {
          flex-direction: column;
          align-items: center;
          text-align: center;
          padding: 0;
        }
        .step-head {
          flex-direction: column;
          align-items: center;
        }
        .step-body p {
          max-width: 260px;
          margin: 0 auto;
        }
        .cards {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      /* ============ STRIKE-THROUGH ANIMATION (Why boucle pain points) ============ */
      .pain {
        position: relative;
      }
      .pain::after {
        content: '';
        position: absolute;
        left: 0;
        top: 55%;
        width: 100%;
        height: 2px;
        background: var(--accent-violet);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 1.4s ease-in-out;
      }
      .pain.strike::after {
        transform: scaleX(1);
      }

      /* ============ WHY BOUCLE SUBTITLE (gold positioning text) ============ */
      .why .section-sub {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--text-gold);
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
      }

      /* ============ HOW IT WORKS — OFFICIAL FORGE LOGOS ============ */
      .how-logos {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 2.5rem;
        list-style: none;
        margin: 0 auto 3rem;
        padding: 0;
      }
      .how-logos li {
        display: inline-flex;
        align-items: center;
      }
      .how-logos img {
        height: 36px;
        width: auto;
        display: block;
      }
      .how-logos .github-logo {
        filter: invert(1);
      }

      /* ============ QUICKSTART TOGGLE ============ */
      .quick-toggle {
        display: flex;
        max-width: 720px;
        margin: 0 auto;
      }
      .toggle-btn {
        padding: 0.5rem 1.5rem;
        background: var(--surface-raised);
        border: 1px solid var(--border-neutral);
        border-bottom: none;
        border-radius: var(--radius) var(--radius) 0 0;
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition:
          background-color 0.2s ease,
          color 0.2s ease,
          border-color 0.2s ease;
      }
      .toggle-btn.active {
        background: var(--accent);
        color: var(--surface-base);
        border-color: var(--accent);
      }
      .toggle-btn:not(.active):hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .quick-panels {
        max-width: 720px;
        margin: 0 auto;
      }
      .quick-panel {
        display: none;
      }
      .quick-panel.active {
        display: block;
      }
      .quick-panel .code {
        border-radius: 0 var(--radius) var(--radius) var(--radius);
        margin: 0;
      }
      .copy-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.75rem;
        padding: 0.4rem 1rem;
        background: transparent;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        cursor: pointer;
        transition:
          color 0.2s ease,
          border-color 0.2s ease;
      }
      .copy-btn:hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .copy-btn.copied {
        color: var(--accent);
        border-color: var(--accent);
      }

      /* ============ REDUCED MOTION ============ */
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .hero-glow {
          animation: none;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main">
      <!-- ============ HERO ============ -->
      <section class="hero" aria-label="boucle — introduction">
        <div class="hero-glow hero-glow--violet" aria-hidden="true"></div>
        <div class="hero-glow hero-glow--gold" aria-hidden="true"></div>
        <div class="hero-motif" aria-hidden="true"></div>

        <div class="hero-inner">
          <div class="logo-lockup">
            <!-- Figurative afro-futurist logo: a face with a golden afro
                 (full circle = the "boucle"), gold hoop créoles, an
                 afrofuturist gold visor with the infinity loop (∞) woven
                 into the bridge. Inline SVG, no raster. -->
            <svg
              viewBox="0 0 100 100"
              role="img"
              aria-label="boucle logo — afrofuturist face with golden afro, créoles, and sunglasses"
              fill="none"
            >
              <!-- Afro: full gold circle (the "boucle") -->
              <circle cx="50" cy="50" r="46" fill="var(--accent, #f5c842)" />
              <!-- Face: figurative silhouette -->
              <path
                d="M50 30
                   C 40 30, 34 36, 34 44
                   L 34 60
                   C 34 70, 40 78, 50 78
                   C 60 78, 66 70, 66 60
                   L 66 44
                   C 66 36, 60 30, 50 30
                   Z"
                fill="var(--surface-base, #0d1117)"
              />
              <!-- Sunglasses: afrofuturist gold visor -->
              <rect x="36" y="44" width="28" height="10" rx="5" fill="var(--accent, #f5c842)" />
              <!-- Infinity loop (∞) woven into the visor bridge -->
              <circle class="loop-pulse" cx="46" cy="49" r="3.5" fill="var(--surface-base, #0d1117)" />
              <circle class="loop-pulse" cx="54" cy="49" r="3.5" fill="var(--surface-base, #0d1117)" />
              <!-- Créoles: gold hoop earrings (dark rings = hoop openings) -->
              <circle cx="30" cy="62" r="5" stroke="var(--surface-base, #0d1117)" stroke-width="2.5" />
              <circle cx="70" cy="62" r="5" stroke="var(--surface-base, #0d1117)" stroke-width="2.5" />
            </svg>
            <span class="wordmark">boucle</span>
          </div>

          <h1>Great ideas deserve to ship.</h1>
          <p class="hero-sub">
            From a ticket in your forge to a feature in production. Boucle
            works so you can live. You decide at the key moments, nothing else. 👍👎
          </p>

          <div class="hero-ctas">
            <a class="btn btn--primary" href="#quick-start">Get started</a>
            <a class="btn btn--ghost" href="#how-it-works">How it works</a>
          </div>
        </div>
      </section>

      <!-- ============ HOW IT WORKS ============ -->
      <section class="how" id="how-it-works" aria-labelledby="how-title">
        <div class="container">
          <h2 id="how-title">How it works</h2>
          <p class="section-sub">
            boucle lives in your forge. GitHub, GitLab. No external tool, no dashboard.
          </p>

          <ul class="how-logos" aria-label="Supported forges">
            <li>
              <img
                src="https://brand.github.com/_next/static/media/logo-03.cc5e5332.png"
                alt="GitHub"
                class="github-logo"
                loading="lazy"
                decoding="async"
              />
            </li>
            <li>
              <img
                src="https://about.gitlab.com/images/press/gitlab-logo-400-rgb.png"
                alt="GitLab"
                loading="lazy"
                decoding="async"
              />
            </li>
          </ul>

          <div class="steps">
            <!-- 1. Drop the idea in an issue -->
            <div class="step">
              <div class="step-head">
                <div class="step-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 3" />
                  </svg>
                </div>
                <div class="step-body">
                  <h3>Drop your idea in an issue</h3>
                  <p>Create an issue in your forge with a title and a description. It's just a normal ticket.</p>
                </div>
              </div>
              <div class="forge-mock" role="img" aria-label="Forge mockup: an open issue with a title and a description.">
                <div class="mock-bar" aria-hidden="true">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                  <span class="mock-url">github.com/my-repo/issues</span>
                </div>
                <div class="mock-body" aria-hidden="true">
                  <p class="mock-badge mock-badge--issue">Issue</p>
                  <p class="mock-title">Add dark mode</p>
                  <p class="mock-desc">When I switch the site to dark mode, the colors don't match the theme.</p>
                  <p class="mock-meta"><span class="mock-avatar"></span> me · open</p>
                </div>
              </div>
            </div>

            <!-- 2. A proposal with an image -->
            <div class="step">
              <div class="step-head">
                <div class="step-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 6h16M4 12h16M4 18h10" />
                  </svg>
                </div>
                <div class="step-body">
                  <h3>Receive a proposal with a preview</h3>
                  <p>boucle analyzes, writes a spec, and posts a comment on the issue with a preview. You see exactly what it will look like.</p>
                </div>
              </div>
              <div class="forge-mock" role="img" aria-label="Forge mockup: a boucle comment with a spec and a preview of the proposed page.">
                <div class="mock-bar" aria-hidden="true">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                  <span class="mock-url">github.com/my-repo/issues/12</span>
                </div>
                <div class="mock-body" aria-hidden="true">
                  <p class="mock-author"><span class="mock-avatar mock-avatar--gold"></span> boucle-bot</p>
                  <p class="mock-comment">Here's the spec and a preview of what it will look like.</p>
                  <div class="mock-preview">
                    <span class="mock-preview-line"></span>
                    <span class="mock-preview-line mock-preview-line--short"></span>
                    <span class="mock-preview-block"></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- 3. Validate with a thumb -->
            <div class="step">
              <div class="step-head">
                <div class="step-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M7 10v10M7 10l3-6a2 2 0 0 1 2-1h1.5A1.5 1.5 0 0 1 15 4.5V9h4a2 2 0 0 1 2 2v1a6 6 0 0 1-1 3.3L18 20H8" />
                  </svg>
                </div>
                <div class="step-body">
                  <h3>Validate with a thumb</h3>
                  <p>React with a thumbs up on the spec comment. No form, no CLI. Just an emoji.</p>
                </div>
              </div>
              <div class="forge-mock" role="img" aria-label="Forge mockup: the thumbs up reaction activated on the spec comment.">
                <div class="mock-bar" aria-hidden="true">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                  <span class="mock-url">github.com/my-repo/issues/12</span>
                </div>
                <div class="mock-body" aria-hidden="true">
                  <div class="mock-reactions">
                    <span class="mock-reaction mock-reaction--active flow-thumb">👍 1</span>
                    <span class="mock-reaction">👀 1</span>
                  </div>
                  <p class="mock-hint">Reaction added: boucle starts.</p>
                </div>
              </div>
            </div>

            <!-- 4. It works -->
            <div class="step">
              <div class="step-head">
                <div class="step-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1" />
                  </svg>
                </div>
                <div class="step-body">
                  <h3>It works</h3>
                  <p>boucle implements, builds, deploys a preview. You have nothing to do meanwhile. The agent works.</p>
                </div>
              </div>
              <div class="forge-mock" role="img" aria-label="Forge mockup: the active work status of the boucle agent with an animation.">
                <div class="mock-bar" aria-hidden="true">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                  <span class="mock-url">github.com/my-repo/actions</span>
                </div>
                <div class="mock-body" aria-hidden="true">
                  <p class="mock-status">
                    <span class="mock-spinner" aria-hidden="true"></span>
                    <span class="mock-pulse"></span>
                    In progress — the agent works
                  </p>
                  <p class="mock-meta">build · preview · verification</p>
                </div>
              </div>
            </div>

            <!-- 5. It is verified -->
            <div class="step">
              <div class="step-head">
                <div class="step-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 12l5 5L20 6" />
                  </svg>
                </div>
                <div class="step-body">
                  <h3>It's verified</h3>
                  <p>The reviewer checks the render, posts a verdict (PASS/FAIL) as a PR comment. If FAIL, it loops. If PASS, the PR is ready.</p>
                </div>
              </div>
              <div class="forge-mock" role="img" aria-label="Forge mockup: a pull request with a PASS verdict comment.">
                <div class="mock-bar" aria-hidden="true">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                  <span class="mock-url">github.com/my-repo/pull/25</span>
                </div>
                <div class="mock-body" aria-hidden="true">
                  <p class="mock-pr-title">Pull request — dark mode</p>
                  <div class="mock-verdict mock-verdict--pass flow-verdict">PASS</div>
                  <p class="mock-comment">Verified: the render matches the spec. Ready to merge.</p>
                </div>
              </div>
            </div>

            <!-- 6. Validate, it is live -->
            <div class="step">
              <div class="step-head">
                <div class="step-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 3v12M7 8l5-5 5 5" />
                    <path d="M4 21h16" />
                  </svg>
                </div>
                <div class="step-body">
                  <h3>Approve, it's live</h3>
                  <p>Approve the PR (or boucle merges per config). The feature ships to production. It's live.</p>
                </div>
              </div>
              <div class="forge-mock" role="img" aria-label="Forge mockup: a merged pull request with a live badge.">
                <div class="mock-bar" aria-hidden="true">
                  <span class="mock-dot"></span><span class="mock-dot"></span><span class="mock-dot"></span>
                  <span class="mock-url">github.com/my-repo/pull/25</span>
                </div>
                <div class="mock-body" aria-hidden="true">
                  <p class="mock-pr-title">Pull request — dark mode</p>
                  <div class="mock-deploy" aria-hidden="true">
                    <span class="mock-deploy-fill"></span>
                  </div>
                  <p class="mock-deploy-label" aria-hidden="true">
                    <svg class="mock-deploy-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <path d="M4 12l5 5L20 6" />
                    </svg>
                    Feature deployed
                  </p>
                  <div class="mock-verdict mock-verdict--merged">MERGED</div>
                  <p class="mock-badge mock-badge--live">● Live in production</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ WHY BOUCLE ============ -->
      <section class="why" id="why-boucle" aria-labelledby="why-title">
        <div class="container">
          <h2 id="why-title">Why boucle</h2>
          <p class="section-sub">
            Harness made for human, made by an indie product builder for product builders.
          </p>

          <div class="cards">
            <div class="card card--featured">
              <h3>Lives in your forge</h3>
              <p class="pain">A new tool to learn, a dashboard to babysit.</p>
              <p class="arrow">→</p>
              <p class="answer">boucle lives in your forge (GitHub/GitLab). No external tool, no separate dashboard. Everything happens where you already work.</p>
            </div>

            <div class="card">
              <h3>Deterministic and reliable</h3>
              <p class="pain">An agent that decides everything, with no human review.</p>
              <p class="arrow">→</p>
              <p class="answer">Deterministic, therefore reliable. You intervene at the right moment, at the decision points.</p>
            </div>

            <div class="card">
              <h3>Works while you sleep</h3>
              <p class="pain">A daemon to babysit, a laptop left on all night.</p>
              <p class="arrow">→</p>
              <p class="answer">The agent works overnight for you. You intervene only when it matters.</p>
            </div>

            <div class="card">
              <h3>No UI, No CLI</h3>
              <p class="pain">A new interface to learn, a command line to master.</p>
              <p class="arrow">→</p>
              <p class="answer">No interface to learn, no command line to master. You interact through your forge: issues, comments, labels.</p>
            </div>

            <div class="card">
              <h3>Self-healing, self-learning loop</h3>
              <p class="pain">A static tool that never improves.</p>
              <p class="arrow">→</p>
              <p class="answer">A loop that learns from its mistakes, self-updates, and adapts to your codebase as your project advances.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ QUICK START ============ -->
      <section class="quick" id="quick-start" aria-labelledby="quick-title">
        <div class="container">
          <h2 id="quick-title">Quick start</h2>
          <p class="section-sub">
            One command, and the loop takes over.
          </p>

          <div class="quick-toggle" role="tablist" aria-label="Install method">
            <button class="toggle-btn active" role="tab" aria-selected="true" data-tab="oneliner">Oneliner</button>
            <button class="toggle-btn" role="tab" aria-selected="false" data-tab="prompt">Prompt</button>
          </div>

          <div class="quick-panels">
            <div class="quick-panel active" role="tabpanel" data-panel="oneliner">
              <pre class="code"><code>curl -fsSL https://ankaboot-source.github.io/boucle.dev/install.sh | bash</code></pre>
              <button class="copy-btn" data-copy="oneliner">Copy</button>
            </div>
            <div class="quick-panel" role="tabpanel" data-panel="prompt">
              <pre class="code"><code>Install boucle on this GitLab/GitHub repository. Execute these steps and report
back what you did:

1. If you are not already inside the target repository — the one whose
   origin remote points to your GitLab host — ask the user for its URL,
   clone it, and work from the clone.
2. git submodule add https://github.com/ankaboot-source/boucle .boucle
3. Run setup in non-interactive mode. It auto-detects the GitLab host and
   project from `git remote get-url origin`, so no value needs to be
   replaced: .boucle/bin/setup --non-interactive
4. Do NOT include an API key anywhere. The API key must never appear in
   this conversation. If setup tells you the key is missing, that's
   expected — it is configured manually in the GitLab UI afterwards.
5. git add .gitmodules .boucle .gitlab-ci.yml && git commit -m "chore: install boucle engine"
6. Show me the URL bin/setup printed for configuring the masked API key,
   and any next steps it listed.</code></pre>
              <button class="copy-btn" data-copy="prompt">Copy</button>
            </div>
          </div>

          <div class="quick-transition">
            <div class="num">Next</div>
            <p>Create an issue in your forge and tag it <code>boucle:triage</code> — the loop starts.</p>
          </div>

          <a class="quick-link" href="https://github.com/ankaboot-source/boucle/blob/main/README.md">
            View the docs →
          </a>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer>
      <p class="footer-made">Made in Africa by <a href="https://ankaboot.io">ankaboot.io</a></p>
      <nav class="footer-links" aria-label="Footer links">
        <a href="https://github.com/ankaboot-source/boucle">GitHub</a>
        <a href="https://github.com/ankaboot-source/boucle/blob/main/LICENSE">License (AGPL-3.0)</a>
        <a href="https://github.com/ankaboot-source/boucle/blob/main/README.md">Docs</a>
      </nav>
    </footer>

    <script>
      // Strike-through animation for pain points — triggers when card enters viewport.
      const painObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('strike');
              painObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 }
      );
      document.querySelectorAll('.pain').forEach((el) => painObserver.observe(el));

      // Quickstart toggle — switch between Oneliner and Prompt panels.
      document.querySelectorAll('.toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const tab = btn.dataset.tab;
          document.querySelectorAll('.toggle-btn').forEach((b) => {
            const isActive = b.dataset.tab === tab;
            b.classList.toggle('active', isActive);
            b.setAttribute('aria-selected', isActive);
          });
          document.querySelectorAll('.quick-panel').forEach((p) => {
            p.classList.toggle('active', p.dataset.panel === tab);
          });
        });
      });

      // Copy-to-clipboard for code panels.
      document.querySelectorAll('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const panel = btn.closest('.quick-panel');
          const code = panel.querySelector('code');
          try {
            await navigator.clipboard.writeText(code.textContent);
            btn.textContent = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => {
              btn.textContent = 'Copy';
              btn.classList.remove('copied');
            }, 2000);
          } catch {
            btn.textContent = 'Failed';
            setTimeout(() => {
              btn.textContent = 'Copy';
            }, 2000);
          }
        });
      });
    </script>
  </body>
</html>
