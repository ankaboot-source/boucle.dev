---
// boucle.dev — landing page
// Afro-futurist + Boucle d'or. Single self-contained page: inline SVG logo,
// inline CSS, all 5 sections. Conforms to VISUAL-CHARTER.md.
const title = 'boucle — zero-code autonomous product builder';
const description =
  "Construire un produit est un jeu d'enfant. D'un ticket dans votre forge à une feature en production. Sans UI, sans agent qui tourne sur votre machine.";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a12" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --surface-base: #0a0a12;
        --bg-secondary: #12121f;
        --surface-raised: #1a1a2e;
        --accent: #f5c842;
        --accent-gold-dim: #c9a233;
        --accent-violet: #7b2ff7;
        --accent-cyan: #00e5ff;
        --text-primary: #f0f0f5;
        --text-secondary: #a0a0b8;
        --text-gold: #f5c842;
        --border: rgba(245, 200, 66, 0.15);
        --glow-gold: rgba(245, 200, 66, 0.3);
        --glow-violet: rgba(123, 47, 247, 0.25);
        --font-display: 'Space Grotesk', 'Inter', sans-serif;
        --font-body: 'Inter', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-body);
        background: var(--surface-base);
        color: var(--text-primary);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      a {
        color: var(--accent-cyan);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--accent);
        color: var(--surface-base);
        padding: 0.75rem 1.25rem;
        font-weight: 600;
        z-index: 100;
      }

      .skip-link:focus {
        left: 0;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      section {
        padding: clamp(3rem, 8vw, 6rem) 1.5rem;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        line-height: 1.15;
        letter-spacing: -0.01em;
      }

      h2 {
        font-size: clamp(1.8rem, 4vw, 3rem);
        font-weight: 600;
        margin-bottom: 1rem;
      }

      .section-intro {
        color: var(--text-secondary);
        max-width: 640px;
        margin-bottom: 3rem;
        font-size: 1.05rem;
      }

      /* ---------- Hero ---------- */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: linear-gradient(180deg, var(--surface-base) 0%, var(--bg-secondary) 100%);
        overflow: hidden;
        padding: 4rem 1.5rem;
      }

      .glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        animation: glow-pulse 4s ease-in-out infinite;
      }

      .glow-violet {
        width: 480px;
        height: 480px;
        background: var(--glow-violet);
        top: -120px;
        left: -120px;
      }

      .glow-gold {
        width: 420px;
        height: 420px;
        background: var(--glow-gold);
        bottom: -140px;
        right: -100px;
        animation-delay: 2s;
      }

      @keyframes glow-pulse {
        0%,
        100% {
          opacity: 0.55;
          transform: scale(1);
        }
        50% {
          opacity: 1;
          transform: scale(1.08);
        }
      }

      .hero-inner {
        position: relative;
        z-index: 1;
        max-width: 820px;
      }

      .logo-mark {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 2rem;
      }

      .logo-mark svg {
        width: 56px;
        height: 56px;
        color: var(--accent);
      }

      .wordmark {
        font-family: var(--font-display);
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-gold);
        letter-spacing: 0.02em;
      }

      .hero h1 {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 700;
        margin-bottom: 1.5rem;
      }

      .hero .subheadline {
        font-size: clamp(1.1rem, 2.4vw, 1.35rem);
        color: var(--text-secondary);
        max-width: 640px;
        margin: 0 auto 2.5rem;
      }

      .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        align-items: center;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0.75rem 1.75rem;
        font-family: var(--font-body);
        font-size: 1rem;
        font-weight: 600;
        border-radius: 999px;
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      }

      .btn-primary {
        background: var(--accent);
        color: var(--surface-base);
        border: 1px solid var(--accent);
      }

      .btn-primary:hover {
        background: var(--accent-gold-dim);
        border-color: var(--accent-gold-dim);
        text-decoration: none;
      }

      .btn-ghost {
        background: transparent;
        color: var(--text-primary);
        border: 1px solid var(--border);
      }

      .btn-ghost:hover {
        border-color: var(--accent);
        color: var(--accent);
        text-decoration: none;
      }

      /* ---------- How it works ---------- */
      .how {
        background: var(--surface-base);
      }

      .steps {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        position: relative;
      }

      .step {
        position: relative;
        padding: 1.5rem;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 0;
      }

      .step-icon {
        width: 48px;
        height: 48px;
        color: var(--accent);
        margin-bottom: 1rem;
      }

      .step h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
      }

      .step p {
        color: var(--text-secondary);
        font-size: 0.95rem;
      }

      /* ---------- Why boucle ---------- */
      .why {
        background: var(--bg-secondary);
      }

      .cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .card {
        background: var(--surface-base);
        border: 1px solid var(--border);
        border-radius: 0;
        padding: 1.75rem;
      }

      .card h3 {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 0.75rem;
      }

      .card .pain {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }

      .card .answer {
        color: var(--text-primary);
        font-size: 1rem;
      }

      .card .arrow {
        color: var(--accent);
        margin-right: 0.25rem;
      }

      /* ---------- Quick start ---------- */
      .quick {
        background: var(--surface-base);
      }

      .quick-steps {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
      }

      .quick-step {
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 0;
        padding: 1.5rem;
      }

      .quick-step .num {
        font-family: var(--font-mono);
        color: var(--accent);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }

      .quick-step h3 {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
      }

      .quick-step pre {
        background: var(--surface-raised);
        border-radius: 0;
        padding: 1rem 1.25rem;
        overflow-x: auto;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--text-primary);
        line-height: 1.5;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .quick-step code {
        font-family: var(--font-mono);
      }

      .doc-link {
        display: inline-block;
        font-weight: 600;
      }

      /* ---------- Footer ---------- */
      .footer {
        background: var(--surface-base);
        border-top: 1px solid var(--border);
        padding: 2.5rem 1.5rem;
        text-align: center;
      }

      .footer .made-in {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-bottom: 1rem;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        justify-content: center;
        font-size: 0.9rem;
      }

      .footer-links a {
        color: var(--text-secondary);
      }

      .footer-links a:hover {
        color: var(--accent);
      }

      /* ---------- Responsive ---------- */
      @media (min-width: 768px) {
        .steps {
          grid-template-columns: 1fr 1fr;
        }

        .cards {
          grid-template-columns: 1fr 1fr;
        }

        .quick-steps {
          grid-template-columns: 1fr;
        }
      }

      @media (min-width: 1024px) {
        .steps {
          grid-template-columns: repeat(4, 1fr);
          gap: 1.5rem;
        }

        .cards {
          grid-template-columns: repeat(4, 1fr);
        }

        .quick-steps {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      /* ---------- Reduced motion ---------- */
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .glow {
          animation: none;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>

    <main id="main">
      <!-- ============ Hero ============ -->
      <header class="hero">
        <div class="glow glow-violet" aria-hidden="true"></div>
        <div class="glow glow-gold" aria-hidden="true"></div>

        <div class="hero-inner">
          <div class="logo-mark">
            <!-- Geometric afro-futurist logo: girl's head with afro hair forming a full gold circle -->
            <svg
              viewBox="0 0 64 64"
              role="img"
              aria-label="Logo boucle — silhouette d'une fille aux cheveux afro dorés"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <!-- Afro hair: full circle -->
              <circle cx="32" cy="30" r="24" fill="currentColor" />
              <!-- Face silhouette (negative space) -->
              <path
                d="M32 14c-6 0-10 4-10 9 0 3 2 5 4 6-1 1-2 2-2 4 0 3 3 5 8 5s8-2 8-5c0-2-1-3-2-4 2-1 4-3 4-6 0-5-4-9-10-9z"
                fill="var(--surface-base)"
              />
              <!-- Eye -->
              <circle cx="30" cy="27" r="1.6" fill="currentColor" />
            </svg>
            <span class="wordmark">boucle</span>
          </div>

          <h1>Construire un produit est un jeu d'enfant</h1>
          <p class="subheadline">
            D'un ticket dans votre forge à une feature en production. Sans UI, sans agent qui
            tourne sur votre machine.
          </p>

          <div class="hero-cta">
            <a class="btn btn-primary" href="#demarrage">Commencer</a>
            <a class="btn btn-ghost" href="#comment-ca-marche">Comment ça marche</a>
          </div>
        </div>
      </header>

      <!-- ============ Comment ça marche ============ -->
      <section class="how" id="comment-ca-marche" aria-labelledby="how-title">
        <div class="container">
          <h2 id="how-title">Comment ça marche</h2>
          <p class="section-intro">
            Une boucle simple, de l'idée au déploiement. Vous restez dans votre forge.
          </p>

          <div class="steps">
            <div class="step">
              <svg class="step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <h3>Issue</h3>
              <p>Vous créez un ticket dans votre forge, comme d'habitude.</p>
            </div>

            <div class="step">
              <svg class="step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M4 6h16M4 12h16M4 18h10" stroke-linecap="round" />
              </svg>
              <h3>Spec</h3>
              <p>boucle analyse et propose une spec que vous validez.</p>
            </div>

            <div class="step">
              <svg class="step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M12 3v12m0 0l-4-4m4 4l4-4" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M5 21h14" stroke-linecap="round" />
              </svg>
              <h3>Implement</h3>
              <p>boucle implémente et ouvre un MR que vous révisez.</p>
            </div>

            <div class="step">
              <svg class="step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M12 3l8 4-8 4-8-4 8-4z" stroke-linejoin="round" />
                <path d="M4 11v6c0 1.1 3.6 3 8 3s8-1.9 8-3v-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <h3>Deploy</h3>
              <p>La feature est déployée en production, vérifiée.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ Pourquoi boucle ============ -->
      <section class="why" id="pourquoi" aria-labelledby="why-title">
        <div class="container">
          <h2 id="why-title">Pourquoi boucle</h2>
          <p class="section-intro">
            Conçu pour les product builders qui veulent livrer sans babysitter un agent.
          </p>

          <div class="cards">
            <div class="card">
              <h3>Pas besoin d'UI</h3>
              <p class="pain">Une nouvelle app à apprendre, un tableau de bord à surveiller.</p>
              <p class="answer"><span class="arrow">→</span> boucle vit dans votre forge. Aucune nouvelle interface.</p>
            </div>

            <div class="card">
              <h3>Pas d'agent qui tourne overnight</h3>
              <p class="pain">Un daemon qui meurt, un laptop laissé allumé toute la nuit.</p>
              <p class="answer"><span class="arrow">→</span> Tout tourne sur le CI de votre forge. Rien à installer.</p>
            </div>

            <div class="card">
              <h3>Vous gardez le contrôle</h3>
              <p class="pain">Un agent qui livre sans validation, sans garde-fou.</p>
              <p class="answer"><span class="arrow">→</span> Des gates humains : vous validez la spec et le MR.</p>
            </div>

            <div class="card">
              <h3>Open-source &amp; open-weight</h3>
              <p class="pain">Une boîte noire propriétaire, vos données chez un tiers.</p>
              <p class="answer"><span class="arrow">→</span> Votre code, vos données, vos tokens restent à vous.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ Démarrage rapide ============ -->
      <section class="quick" id="demarrage" aria-labelledby="quick-title">
        <div class="container">
          <h2 id="quick-title">Démarrage rapide</h2>
          <p class="section-intro">
            Trois étapes, et la boucle prend le relais.
          </p>

          <div class="quick-steps">
            <div class="quick-step">
              <p class="num">01</p>
              <h3>Ajoutez boucle en submodule</h3>
              <pre><code>git submodule add https://github.com/ankaboot-source/boucle .boucle</code></pre>
            </div>

            <div class="quick-step">
              <p class="num">02</p>
              <h3>Lancez le setup</h3>
              <pre><code>.boucle/bin/setup gitlab</code></pre>
            </div>

            <div class="quick-step">
              <p class="num">03</p>
              <h3>Créez une issue</h3>
              <pre><code># Créez une issue avec le label boucle:triage</code></pre>
            </div>
          </div>

          <a class="doc-link" href="https://github.com/ankaboot-source/boucle#readme">Voir la doc →</a>
        </div>
      </section>
    </main>

    <!-- ============ Footer ============ -->
    <footer class="footer">
      <p class="made-in">Made in Africa 🌍 for the world</p>
      <nav class="footer-links" aria-label="Liens du pied de page">
        <a href="https://github.com/ankaboot-source/boucle">GitHub</a>
        <a href="https://github.com/ankaboot-source/boucle/blob/main/LICENSE">License (AGPL-3.0)</a>
        <a href="https://github.com/ankaboot-source/boucle#readme">Docs</a>
      </nav>
    </footer>
  </body>
</html>
