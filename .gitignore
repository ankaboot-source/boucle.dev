# boucle per-issue state (generated by bin/setup)
.boucle-state/

# dependencies
node_modules/

# astro build cache
.astro/

# astro build output (configured via outDir in astro.config.mjs)
# NOTE: GitLab Pages expects the output in public/, so we do NOT
# gitignore public/ — the pages job publishes it as an artifact.
# But we do gitignore the build output that lands in dist/ by default.
dist/

# jcode runtime db
.jcode-*.db
.jcode-*.db-shm
.jcode-*.db-wal

# logs
npm-debug.log*

# environment variables
.env
.env.production

# macOS
.DS_Store

# editor
.idea/